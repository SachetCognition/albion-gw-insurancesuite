<?xml version="1.0"?>
<!-- Albion BillingCenter batch schedules. Entries with disabled="true" are run by Control-M in that environment instead of the Guidewire scheduler. -->
<scheduler-config xmlns="http://guidewire.com/scheduler">
  <process-schedule process="AlbionCollectionsF_Ext" cron="0 16 0 * * ?" disabled="false"/>
</scheduler-config>
