<?xml version="1.0"?>
<!-- Albion outbound messaging destinations. Each transport plugin (config/plugin/registry/*Transport.gwp) spools
     messages to its feed for Control-M file transfer. InOrder destinations keep multithreadnonsafeorderedmessages="false". -->
<messaging-config
  xmlns="http://guidewire.com/messaging-config">
  <messaging>
    <!-- Motor Insurance Database (MIB) vehicle feed -->
    <destination
      id="60"
      name="Albion Motor Insurance Database (MIB) vehicle feed"
      transportplugin="MidTransport"
      pollinterval="5000"
      initialretryinterval="300000"
      multithreadnonsafeorderedmessages="false"/>
    <!-- Claims and Underwriting Exchange enquiry/load -->
    <destination
      id="61"
      name="Albion Claims and Underwriting Exchange enquiry/load"
      transportplugin="CueTransport"
      pollinterval="5000"
      initialretryinterval="300000"
      multithreadnonsafeorderedmessages="false"/>
    <!-- Employers Liability Tracing Office ELD feed -->
    <destination
      id="62"
      name="Albion Employers Liability Tracing Office ELD feed"
      transportplugin="EltoTransport"
      pollinterval="60000"
      initialretryinterval="300000"
      multithreadnonsafeorderedmessages="true"/>
    <!-- Flood Re cession and bordereaux -->
    <destination
      id="63"
      name="Albion Flood Re cession and bordereaux"
      transportplugin="FloodreTransport"
      pollinterval="30000"
      initialretryinterval="60000"
      multithreadnonsafeorderedmessages="false"/>
    <!-- HMT/OFSI sanctions and PEP screening via WorldCheck -->
    <destination
      id="64"
      name="Albion HMT/OFSI sanctions and PEP screening via WorldCheck"
      transportplugin="SanctionsTransport"
      pollinterval="60000"
      initialretryinterval="60000"
      multithreadnonsafeorderedmessages="true"/>
    <!-- DVLA MyLicence ADD/DDS lookup -->
    <destination
      id="65"
      name="Albion DVLA MyLicence ADD/DDS lookup"
      transportplugin="DvlaTransport"
      pollinterval="5000"
      initialretryinterval="60000"
      multithreadnonsafeorderedmessages="false"/>
    <!-- CIFAS fraud database -->
    <destination
      id="66"
      name="Albion CIFAS fraud database"
      transportplugin="CifasTransport"
      pollinterval="60000"
      initialretryinterval="300000"
      multithreadnonsafeorderedmessages="false"/>
    <!-- Insurance Premium Tax calculation and HMRC returns -->
    <destination
      id="67"
      name="Albion Insurance Premium Tax calculation and HMRC returns"
      transportplugin="IptTransport"
      pollinterval="60000"
      initialretryinterval="60000"
      multithreadnonsafeorderedmessages="true"/>
    <!-- POLARIS mainframe policy admin (heritage book) nightly sync -->
    <destination
      id="68"
      name="Albion POLARIS mainframe policy admin (heritage book) nightly sync"
      transportplugin="PolarisMfTransport"
      pollinterval="5000"
      initialretryinterval="300000"
      multithreadnonsafeorderedmessages="false"/>
    <!-- Group Payment Hub (BACS/Direct Debit/Faster Payments) -->
    <destination
      id="69"
      name="Albion Group Payment Hub (BACS/Direct Debit/Faster Payments)"
      transportplugin="PayhubTransport"
      pollinterval="30000"
      initialretryinterval="60000"
      multithreadnonsafeorderedmessages="false"/>
  </messaging>
</messaging-config>
