  private static function evaluateStandard(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially hydrated (AGI-41446)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var cfg = AlbionConfigService.Instance
    var referAlbDir = cfg.referThresholdAlbDir("AlbionDefaultNoticeManager", 7500bd)
    var referAlbBrk = cfg.referThresholdAlbBrk("AlbionDefaultNoticeManager", 4000bd)
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > referAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > referAlbBrk) { result.add("REFER_UW") }
        if (amount > referAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // AGI-9340 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, AGI-9340)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P229 behaviour exactly
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer to underwriting
    }
    return result
  }

  /** ALBDIR rules, formerly brandvariants.AlbionDefaultNoticeManager_ALBDIR (diverged 26-Jan-2014). */
  private static function evaluateAlbdirVariant(bean : KeyableBean) : List<String> {
