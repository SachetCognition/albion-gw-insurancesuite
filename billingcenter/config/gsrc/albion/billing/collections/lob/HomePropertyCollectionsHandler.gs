class HomePropertyCollectionsHandler {

  // Referral thresholds signed off by UW committee 12-May-2024; legacy values pinned per class via AlbionConfigService
  public static function evaluateHomePropertyCollectionsHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially hydrated (GWCC-9545)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var cfg = AlbionConfigService.Instance
    var referAlbDir = cfg.referThresholdAlbDir("HomePropertyCollectionsHandler", 10000bd)
    var referAlbBrk = cfg.referThresholdAlbBrk("HomePropertyCollectionsHandler", 4000bd)
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > referAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > referAlbBrk) { result.add("REFER_UW") }
        if (amount > referAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // GWPC-29980 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWPC-29980)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P270 behaviour exactly
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer to underwriting
    }
    return result
  }

