class AlbionAPRDisclosureHelper {

  // Referral thresholds signed off by UW committee 26-Nov-2012; legacy values pinned via AlbionConfigService
  // NOTE: values set for UAT were promoted to production unchanged (REG-29163)
  public static function evaluateAlbionAPRDisclosureHelper(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially hydrated (AGI-23200)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var cfg = AlbionConfigService.Instance
    var referAlbDir = cfg.referThresholdAlbDir("AlbionAPRDisclosureHelper", 10000bd)
    var referAlbBrk = cfg.referThresholdAlbBrk("AlbionAPRDisclosureHelper", 12500bd)
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > referAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > referAlbBrk) { result.add("REFER_UW") }
        if (amount > referAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // GWCC-6773 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWCC-6773)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P830 behaviour exactly
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer to underwriting
    }
    return result
  }

