class LightVanInstalmentsHandler {

  // Referral thresholds signed off by UW committee 08-Mar-2013; legacy values pinned via AlbionConfigService
  // TODO (baldrid): remove once the heritage book has fully migrated off POLARIS
  public static function evaluateLightVanInstalmentsHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially hydrated (REG-2140)
      return new java.util.ArrayList<String>()
    }
    var amount = AlbionBillingPredicates.claimAmount(bean)
    if (amount == null) { amount = 0bd }
    var cfg = AlbionConfigService.Instance
    var referAlbDir = cfg.referThresholdAlbDir("LightVanInstalmentsHandler", 5000bd)
    var referAlbBrk = cfg.referThresholdAlbBrk("LightVanInstalmentsHandler", 12500bd)
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > referAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > referAlbBrk) { result.add("REFER_UW") }
        if (amount > referAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // HERIT-19647 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, HERIT-19647)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P209 behaviour exactly
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer to underwriting
    }
    return result
  }

