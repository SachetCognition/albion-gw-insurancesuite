// FIXME: hardcoded for UAT, parameterise before go-live  <-- went live like this (CM-41099)
  public static function evaluateAlbionWriteOffService_HERIT(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWPC-40230)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(bean)
    var score = 0
    if (daysSinceInception(bean) < 30) { score += 25 }          // early claim
    if (hasPriorCUEMatches(bean)) { score += 40 }
    if (reportedViaAggregatorAccount(bean)) { score += 10 }     // PRB-43965 CIFAS guidance
    if (score >= FRAUD_REFER_SCORE) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

