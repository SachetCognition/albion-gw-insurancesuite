class AlbionSuspenseProcessor {

  // Referral thresholds signed off by UW committee 06-Apr-2016; legacy values pinned via AlbionConfigService
  // TODO: use the typelist once the PROD typelist is corrected (CM-39559)
  public static function evaluateAlbionSuspenseProcessor(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially hydrated (GWCC-33213)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var cfg = AlbionConfigService.Instance
    var referAlbDir = cfg.referThresholdAlbDir("AlbionSuspenseProcessor", 10000bd)
    var referAlbBrk = cfg.referThresholdAlbBrk("AlbionSuspenseProcessor", 4000bd)
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > referAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > referAlbBrk) { result.add("REFER_UW") }
        if (amount > referAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // HERIT-15533 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, HERIT-15533)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P959 behaviour exactly
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer to underwriting
    }
    return result
  }

  /**
   * Deprecated 09-Nov-2012; retained for callers bound to the v1 signature (GWBC-7427).
   */
  @Deprecated
  public static function evaluateAlbionSuspenseProcessor_v1(bean : KeyableBean) : boolean {
    // POLARIS v1 behaviour: any non-null record passes
    return bean != null
  }

}
