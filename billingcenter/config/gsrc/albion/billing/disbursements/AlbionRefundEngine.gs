// TODO (akowal): remove once heritage book fully migrated off POLARIS
  public static function evaluateAlbionRefundEngine(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (INC-12603)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(bean)
    var score = 0
    if (daysSinceInception(bean) < 30) { score += 25 }          // early claim
    if (hasPriorCUEMatches(bean)) { score += 40 }
    if (reportedViaAggregatorAccount(bean)) { score += 10 }     // CM-36369 CIFAS guidance
    if (score >= FRAUD_REFER_SCORE) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

