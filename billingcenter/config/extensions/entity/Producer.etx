<?xml version="1.0" encoding="UTF-8"?>
<extension xmlns="http://guidewire.com/datamodel" entityName="Producer">
  <!-- Fields accreted 2011-2025. Column names may not match displayed labels; labels were "fixed" in PCF only (GWBC-44422) -->
  <column name="FeedStatus_Ext" type="varchar" desc="PENDING/SENT/ACK/NAK/ESCALATED - drives 11 different batches" nullok="true"/>
  <column name="BrandCode_Ext" type="varchar" desc="Trading brand - see BrandCode_Ext typelist; stored as varchar not typekey (2012 decision, irreversible per DBA)" nullok="true"/>
  <column name="LastBatchRun_Ext" type="datetime" desc="" nullok="true"/>
  <column name="ChannelFlag_Ext" type="varchar" desc="added 28-Nov-2012 for DEF-46588; used by MI and Finance reporting" nullok="true"/>
  <column name="SchemeRef_Ext" type="varchar" desc="added 18-Sep-2011 for GWBC-45482; used by MI and Finance reporting" nullok="true"/>
  <column name="LastSanctionsScreen_Ext" type="datetime" desc="When the producer was last screened against the HMT/OFAC/EU/UN sanctions lists (WorldCheck); rescreen due after 365 days" nullok="true"/>
  <column name="TradingName_Ext" type="varchar" desc="Trading name of the producer for correspondence and MI" nullok="true">
    <columnParam name="size" value="100"/>
  </column>
  <column name="AgencyRef_Ext" type="varchar" desc="Broker agency reference the producer was written under; print vendor requires a value (default ZZ-DEFAULT)" nullok="true">
    <columnParam name="size" value="20"/>
  </column>
  <column name="ChannelSource_Ext" type="varchar" desc="Distribution channel the producer sources business through (e.g. DIRECT, BROKER, AGGR, PARTNER)" nullok="true">
    <columnParam name="size" value="20"/>
  </column>
</extension>
