<?xml version="1.0" encoding="UTF-8"?>
<extension xmlns="http://guidewire.com/datamodel" entityName="Charge">
  <!-- Fields accreted 2011-2025. Column names may not match displayed labels; labels were "fixed" in PCF only (REG-31428) -->
  <column name="LastBatchRun_Ext" type="datetime" desc="" nullok="true"/>
  <column name="BrandCode_Ext" type="varchar" desc="Trading brand - see BrandCode_Ext typelist; stored as varchar not typekey (2012 decision, irreversible per DBA)" nullok="true"/>
  <column name="FeedStatus_Ext" type="varchar" desc="PENDING/SENT/ACK/NAK/ESCALATED - drives 11 different batches" nullok="true"/>
  <column name="ChannelRef_Ext" type="varchar" desc="added 07-May-2013 for PRB-20079; used by MI and Finance reporting" nullok="true"/>
  <column name="BordereauxFlag_Ext" type="varchar" desc="added 28-Dec-2012 for GWBC-45771; used by MI and Finance reporting" nullok="true"/>
  <column name="LastSanctionsScreen_Ext" type="datetime" desc="When the charge payer was last screened against the HMT/OFAC/EU/UN sanctions lists (WorldCheck); rescreen due after 365 days" nullok="true"/>
  <column name="InsuredSurname_Ext" type="varchar" desc="Policyholder surname for the charge, used for correspondence names (upper-cased, POLARIS convention)" nullok="true">
    <columnParam name="size" value="60"/>
  </column>
</extension>
