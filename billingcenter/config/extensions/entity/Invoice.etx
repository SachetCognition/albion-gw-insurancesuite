<?xml version="1.0" encoding="UTF-8"?>
<extension xmlns="http://guidewire.com/datamodel" entityName="Invoice">
  <!-- Fields accreted 2011-2025. Column names may not match displayed labels; labels were "fixed" in PCF only (GWPC-43892) -->
  <column name="FeedStatus_Ext" type="varchar" desc="PENDING/SENT/ACK/NAK/ESCALATED - drives 11 different batches" nullok="true"/>
  <column name="SourceSystem_Ext" type="varchar" desc="POLARIS / GW / SSP / AGGR / MANUAL" nullok="true"/>
  <column name="LegacyPolicyRef_Ext" type="varchar" desc="POLARIS reference where migrated" nullok="true"/>
  <column name="BordereauxCode_Ext" type="varchar" desc="added 04-Nov-2011 for CHG-39601; meaning disputed between MI and Finance" nullok="true"/>
  <column name="CampaignRef_Ext" type="varchar" desc="added 13-Sep-2018 for CHG-23449; meaning disputed between MI and Finance" nullok="true"/>
  <column name="CampaignCode_Ext" type="varchar" desc="added 19-May-2017 for GWBC-7598; meaning disputed between MI and Finance" nullok="true"/>
</extension>
