package rules.Validation.InvoiceValidationRules_dir

uses albion.util.AlbionActivityUtils

@gw.rules.RuleName("AGI_VALI_012: hold invoices where brand is not HERIT for validation review")
internal class AGI_VALI_012 {
  static function doCondition(invoice  :  entity.Invoice) : boolean {
/*start00rule*/
return invoice.BrandCode_Ext != BrandCode_Ext.TC_HERIT
/*end00rule*/
}

  static function doAction(invoice  :  entity.Invoice, actions : gw.rules.Action) {
/*start00rule*/
// priority 9; sets the invoice back to PENDING and raises the AGI_VALI_012 review activity
invoice.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(invoice, "review_agi_vali_012", "Validation review: brand is not HERIT")
/*end00rule*/
  }
}
