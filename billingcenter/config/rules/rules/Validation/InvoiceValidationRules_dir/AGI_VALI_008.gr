package rules.Validation.InvoiceValidationRules_dir

uses albion.util.AlbionActivityUtils
uses gw.api.locale.DisplayKey

@gw.rules.RuleName("AGI_VALI_008: hold invoices where brand is ALBDIR for validation review")
internal class AGI_VALI_008 {
  static function doCondition(invoice  :  entity.Invoice) : boolean {
/*start00rule*/
return invoice.BrandCode_Ext == BrandCode_Ext.TC_ALBDIR
/*end00rule*/
}

  static function doAction(invoice  :  entity.Invoice, actions : gw.rules.Action) {
/*start00rule*/
// priority 884; sets the invoice back to PENDING and raises the AGI_VALI_008 review activity
invoice.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(invoice, "review_agi_vali_008", DisplayKey.get("Albion.Activity.Subject.AGI_VALI_008"))
/*end00rule*/
  }
}
