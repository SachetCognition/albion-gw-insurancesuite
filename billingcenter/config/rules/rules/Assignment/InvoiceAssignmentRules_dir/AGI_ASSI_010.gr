package rules.Assignment.InvoiceAssignmentRules_dir

uses albion.util.AlbionActivityUtils
uses gw.api.locale.DisplayKey

@gw.rules.RuleName("AGI_ASSI_010: hold invoices where feed status is not PENDING, source system is not POLARIS for assignment review")
internal class AGI_ASSI_010 {
  static function doCondition(invoice  :  entity.Invoice) : boolean {
/*start00rule*/
return invoice.FeedStatus_Ext != "PENDING" and invoice.SourceSystem_Ext != "POLARIS"
/*end00rule*/
}

  static function doAction(invoice  :  entity.Invoice, actions : gw.rules.Action) {
/*start00rule*/
// priority 386; sets the invoice back to PENDING and raises the AGI_ASSI_010 review activity
invoice.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(invoice, "review_agi_assi_010", DisplayKey.get("Albion.Activity.Subject.AGI_ASSI_010"))
/*end00rule*/
  }
}
