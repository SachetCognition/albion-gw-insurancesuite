<?xml version="1.0" encoding="UTF-8"?>
<!-- AlbionScreeningLV.pcf : derived from the base OOTB screen and customised; not re-based during the v9->v10 upgrade (GWPC-41083). -->
<PCF xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../pcf.xsd">
  <ListView
    id="AlbionScreeningLV">
    <Require
      name="Invoices"
      type="Invoice[]"/>
    <RowIterator
      editable="true"
      elementName="Invoice"
      pageSize="20"
      type="Invoice"
      value="Invoices"
      valueType="Invoice[]">
        <Row>
          <TextCell
            editable="false"
            id="SchemeCode_Ext"
            label="&quot;SchemeCode&quot;"
            value="Invoice.SchemeCode_Ext"/>
          <TextCell
            editable="true"
            id="SourceSystem_Ext"
            label="&quot;SourceSystem&quot;"
            value="Invoice.SourceSystem_Ext"/>
          <TextCell
            editable="false"
            id="CampaignCode_Ext"
            label="&quot;CampaignCode&quot;"
            value="Invoice.CampaignCode_Ext"/>
          <TextCell
            editable="true"
            id="FeedStatus_Ext"
            label="&quot;FeedStatus&quot;"
            value="Invoice.FeedStatus_Ext"/>
          <BooleanRadioCell
            editable="true"
            id="VulnerableCustomerFlag"
            label="&quot;Vulnerable Customer (FG21/1)&quot;"
            value="Invoice.VulnerabilityNoted_Ext"/>
          <TypeKeyCell
            editable="false"
            id="BrandCode"
            label="&quot;Brand&quot;"
            value="Invoice.BrandCode_Ext"/>
          <TextCell
            editable="false"
            id="LegacyRef"
            label="&quot;POLARIS Ref&quot;"
            tooltip="&quot;Heritage book only. If populated, cross-check the mainframe before ANY financial change.&quot;"
            value="Invoice.LegacyPolicyRef_Ext"/>
        </Row>
    </RowIterator>
  </ListView>
</PCF>
