<?xml version="1.0" encoding="UTF-8"?>
<!-- AlbionPaymentsPopup.pcf : derived from the base OOTB screen and customised; not re-based during the v9->v10 upgrade (GWCC-921). -->
<PCF xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../pcf.xsd">
  <Popup
    canEdit="true"
    id="AlbionPaymentsPopup"
    title="&quot;Invoice&quot;">
    <LocationEntryPoint
      signature="AlbionPaymentsPopup(Invoice : Invoice)"/>
    <Variable
      name="Invoice"
      type="Invoice"/>
    <Screen
      id="AlbionPaymentsPopupScreen">
      <Toolbar>
        <EditButtons/>
      </Toolbar>
      <DetailViewPanel>
        <InputColumn>
            <TypeKeyInput
              editable="false"
              id="BrandCode_Ext"
              label="&quot;BrandCode&quot;"
              value="Invoice.BrandCode_Ext"/>
            <TextInput
              editable="false"
              id="FeedStatus_Ext"
              label="&quot;FeedStatus&quot;"
              value="Invoice.FeedStatus_Ext"/>
            <TextInput
              editable="true"
              id="ChannelRef_Ext"
              label="&quot;ChannelRef&quot;"
              value="Invoice.ChannelRef_Ext"/>
            <TextInput
              editable="true"
              id="SchemeCode_Ext"
              label="&quot;SchemeCode&quot;"
              value="Invoice.SchemeCode_Ext"/>
          <BooleanRadioInput
            editable="true"
            id="VulnerableCustomerFlag"
            label="&quot;Vulnerable Customer (FG21/1)&quot;"
            value="Invoice.VulnerabilityNoted_Ext"/>
        </InputColumn>
        <InputColumn>
          <TypeKeyInput
            editable="false"
            id="BrandCode"
            label="&quot;Brand&quot;"
            value="Invoice.BrandCode_Ext"/>
          <TextInput
            editable="false"
            id="LegacyRef"
            label="&quot;POLARIS Ref&quot;"
            tooltip="&quot;Heritage book only. If populated, cross-check the mainframe before ANY financial change.&quot;"
            value="Invoice.LegacyPolicyRef_Ext"/>
        </InputColumn>
      </DetailViewPanel>
    </Screen>
  </Popup>
</PCF>
