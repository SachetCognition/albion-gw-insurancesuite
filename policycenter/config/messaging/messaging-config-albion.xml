<?xml version="1.0"?>
<!-- Albion outbound interfaces. Each destination uses a plugin registered in plugin/registry/<Name>Transport.gwp. -->
<messaging-config xmlns="http://guidewire.com/messaging-config" defaultServer="#messaging">
  <messaging>
    <!-- Motor Insurance Database (MIB) vehicle feed; in-order delivery -->
    <destination
      id="60"
      name="AlbionMid"
      transportplugin="MidTransport"
      pollinterval="5000"
      initialretryinterval="300000"
      maxretries="5"
      multithreadnonsafeorderedmessages="false"
      singlethreadandblockonnonsafeorderedmessages="true"/>
    <!-- Claims and Underwriting Exchange enquiry/load; in-order delivery -->
    <destination
      id="61"
      name="AlbionCue"
      transportplugin="CueTransport"
      pollinterval="60000"
      initialretryinterval="300000"
      maxretries="5"
      multithreadnonsafeorderedmessages="false"
      singlethreadandblockonnonsafeorderedmessages="true"/>
    <!-- Employers Liability Tracing Office ELD feed; in-order delivery -->
    <destination
      id="62"
      name="AlbionElto"
      transportplugin="EltoTransport"
      pollinterval="30000"
      initialretryinterval="300000"
      maxretries="5"
      multithreadnonsafeorderedmessages="false"
      singlethreadandblockonnonsafeorderedmessages="true"/>
    <!-- Flood Re cession and bordereaux; in-order delivery -->
    <destination
      id="63"
      name="AlbionFloodre"
      transportplugin="FloodreTransport"
      pollinterval="60000"
      initialretryinterval="60000"
      maxretries="5"
      multithreadnonsafeorderedmessages="false"
      singlethreadandblockonnonsafeorderedmessages="true"/>
    <!-- HMT/OFSI sanctions and PEP screening via WorldCheck; any-order delivery -->
    <destination
      id="64"
      name="AlbionSanctions"
      transportplugin="SanctionsTransport"
      pollinterval="30000"
      initialretryinterval="60000"
      maxretries="5"
      multithreadnonsafeorderedmessages="false"
      singlethreadandblockonnonsafeorderedmessages="false"/>
    <!-- DVLA MyLicence ADD/DDS lookup; in-order delivery -->
    <destination
      id="65"
      name="AlbionDvla"
      transportplugin="DvlaTransport"
      pollinterval="60000"
      initialretryinterval="300000"
      maxretries="5"
      multithreadnonsafeorderedmessages="false"
      singlethreadandblockonnonsafeorderedmessages="true"/>
    <!-- CIFAS fraud database; any-order delivery -->
    <destination
      id="66"
      name="AlbionCifas"
      transportplugin="CifasTransport"
      pollinterval="30000"
      initialretryinterval="60000"
      maxretries="5"
      multithreadnonsafeorderedmessages="false"
      singlethreadandblockonnonsafeorderedmessages="false"/>
    <!-- Insurance Premium Tax calculation and HMRC returns; in-order delivery -->
    <destination
      id="67"
      name="AlbionIpt"
      transportplugin="IptTransport"
      pollinterval="60000"
      initialretryinterval="300000"
      maxretries="5"
      multithreadnonsafeorderedmessages="false"
      singlethreadandblockonnonsafeorderedmessages="true"/>
    <!-- POLARIS mainframe policy admin (heritage book) nightly sync; in-order delivery -->
    <destination
      id="68"
      name="AlbionPolarisMf"
      transportplugin="PolarisMfTransport"
      pollinterval="5000"
      initialretryinterval="60000"
      maxretries="5"
      multithreadnonsafeorderedmessages="false"
      singlethreadandblockonnonsafeorderedmessages="true"/>
    <!-- Group Payment Hub (BACS/Direct Debit/Faster Payments); in-order delivery -->
    <destination
      id="69"
      name="AlbionPayhub"
      transportplugin="PayhubTransport"
      pollinterval="5000"
      initialretryinterval="300000"
      maxretries="5"
      multithreadnonsafeorderedmessages="false"
      singlethreadandblockonnonsafeorderedmessages="true"/>
  </messaging>
</messaging-config>
