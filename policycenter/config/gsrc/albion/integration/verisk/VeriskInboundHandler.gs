class VeriskInboundHandler {

  public static function evaluateVeriskInboundHandler(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWCC-33905)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionPolicyPredicates.daysSinceInception(msg) < 30) { score += 25 }          // early claim
    if (AlbionPolicyPredicates.hasPriorCueMatch(msg)) { score += 40 }
    if (AlbionPolicyPredicates.isAggregatorSourced(msg)) { score += 10 }     // PRB-2902 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

