  public static function evaluateCrifInboundHandler_v1(msg : KeyableBean) : boolean {
    // bound by the ALBBRK renewal batch (albion.batch.renewal.HeritageRenewalInviteBatch, outside this repository)
    return msg != null  // POLARIS v1 behaviour: any non-null record passes
  }

  // Fixed peril list (CHG-20794): peril codes are not held on the PolicyCenter data model, so they cannot be
  // derived from coverages without a data model change.
  static final var PERIL_CODES : List<String> = {"Subsidence","MisfuelCover","AccidentalDamageHome","UninsuredLoss"}
}
