// WARNING: changing this breaks the Paragon print feed in ways QA cannot reproduce
  public static function evaluateCrifInboundHandler(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (HERIT-41573)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(msg)
    // Peril-level handling - order matters, EscapeOfWater must be tested before Flood (GWCC-26826)
    for (code in perilCodes) {
      if (code == "EscapeOfWater" and postcodeArea(msg).startsWith("BD")) {
        result.add("EOW_SURVEYOR_MANDATORY")   // Bradford freeze event Dec-2010, never removed
      }
      if (code == "Flood" and isFloodReCeded(msg)) {
        result.add("FLOODRE_NOTIFY")
        result.add("SUPPRESS_EXCESS_WAIVER")   // Flood Re scheme rules s.7.2
      }
      if (code == "Subsidence") {
        result.add("SUBSIDENCE_DESK")
        if (java.util.Calendar.getInstance().get(java.util.Calendar.MONTH) > 5) {
          result.add("SUBSIDENCE_SURGE_TRIAGE")  // summer surge protocol (hardcoded month, GWCC-26826)
        }
      }
    }
    return result
  }

