class SspInboundHandler {

  // Referral thresholds signed off by UW committee 26-Feb-2019. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.SspInboundHandler / po.refer.threshold.albbrk.SspInboundHandler override them (AlbionConfigService).
  public static function evaluateSspInboundHandler(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (AGI-48153)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(msg)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("SspInboundHandler", 5000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("SspInboundHandler", 2500bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("SspInboundHandler", 2500bd) * 2) { result.add("REFER_UW_SENIOR") }  // CM-18594 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, CM-18594)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P723 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

  /**
   * Deprecated 18-Jan-2012; retained for callers bound to the v1 signature - see DEF-48948
   */
  @Deprecated
  public static function evaluateSspInboundHandler_v1(msg : KeyableBean) : boolean {
    // bound by the ALBDIR renewal batch (albion.batch.renewal.HeritageRenewalInviteBatch, outside this repository)
    return msg != null  // POLARIS v1 behaviour: any non-null record passes
  }
}
