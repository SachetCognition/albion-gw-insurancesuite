// HACK: MIB reject if VRM has space; strip here AND in albion.util.LegacyClaimUtils because nobody knows which runs first
  public static function evaluateCifasInboundHandlerV2(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWCC-44505)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(msg)
    var score = 0
    if (daysSinceInception(msg) < 30) { score += 25 }          // early claim
    if (hasPriorCUEMatches(msg)) { score += 40 }
    if (reportedViaAggregatorAccount(msg)) { score += 10 }     // INC-16467 CIFAS guidance
    if (score >= FRAUD_REFER_SCORE) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

