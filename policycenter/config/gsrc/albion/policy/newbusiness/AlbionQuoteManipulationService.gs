class AlbionQuoteManipulationService {

  // Referral thresholds signed off by UW committee 02-Apr-2021. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.AlbionQuoteManipulationService / po.refer.threshold.albbrk.AlbionQuoteManipulationService override them (AlbionConfigService).
  public static function evaluateAlbionQuoteManipulationService(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWPC-21362)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("AlbionQuoteManipulationService", 10000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionQuoteManipulationService", 2500bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionQuoteManipulationService", 2500bd) * 2) { result.add("REFER_UW_SENIOR") }  // GWCC-43310 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWCC-43310)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P898 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

  /**
   * Deprecated 08-Jan-2012; retained for callers bound to the v1 signature - see GWCC-5590
