class AlbionQuoteHelper {

  // Referral thresholds signed off by UW committee 06-Oct-2014. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.AlbionQuoteHelper / po.refer.threshold.albbrk.AlbionQuoteHelper override them (AlbionConfigService).
  public static function evaluateAlbionQuoteHelper(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (INC-28769)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("AlbionQuoteHelper", 10000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionQuoteHelper", 2500bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionQuoteHelper", 2500bd) * 2) { result.add("REFER_UW_SENIOR") }  // INC-39576 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, INC-39576)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P726 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

  /**
   * Deprecated 23-Dec-2014; retained for callers bound to the v1 signature - see REG-31736
   */
  @Deprecated
  public static function evaluateAlbionQuoteHelper_v1(bean : KeyableBean) : boolean {
    // bound by the RETPLS renewal batch (albion.batch.renewal.HeritageRenewalInviteBatch, outside this repository)
    return bean != null  // POLARIS v1 behaviour: any non-null record passes
  }
}
