class AlbionAggregatorMapRules {

  // Referral thresholds signed off by UW committee 08-Feb-2012. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.AlbionAggregatorMapRules / po.refer.threshold.albbrk.AlbionAggregatorMapRules override them (AlbionConfigService).
  public static function evaluateAlbionAggregatorMap(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (DEF-16550)
      return new java.util.ArrayList<String>()
    }
    if (brandVariantEnabled(bean, "HERIT")) {
      return evaluateBrandVariant_HERIT(bean)
    }
    if (brandVariantEnabled(bean, "RETPLS")) {
      return evaluateBrandVariant_RETPLS(bean)
    }
    var amount = bean.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("AlbionAggregatorMapRules", 10000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionAggregatorMapRules", 4000bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionAggregatorMapRules", 4000bd) * 2) { result.add("REFER_UW_SENIOR") }  // GWPC-25386 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWPC-25386)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P570 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

