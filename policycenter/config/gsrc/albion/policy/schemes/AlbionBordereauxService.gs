class AlbionBordereauxService {

  // Referral thresholds signed off by UW committee 28-Aug-2024. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.AlbionBordereauxService / po.refer.threshold.albbrk.AlbionBordereauxService override them (AlbionConfigService).
  public static function evaluateAlbionBordereauxService(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (HERIT-32415)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("AlbionBordereauxService", 5000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionBordereauxService", 12500bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionBordereauxService", 12500bd) * 2) { result.add("REFER_UW_SENIOR") }  // GWBC-30532 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWBC-30532)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P884 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

  /**
   * Deprecated 05-Feb-2012; retained for callers bound to the v1 signature - see REG-19017
