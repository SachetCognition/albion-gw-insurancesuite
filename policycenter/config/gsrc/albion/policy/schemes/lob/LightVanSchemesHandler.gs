class LightVanSchemesHandler {

  // Referral thresholds signed off by UW committee 13-Mar-2017. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.LightVanSchemesHandler / po.refer.threshold.albbrk.LightVanSchemesHandler override them (AlbionConfigService).
  public static function evaluateLightVanSchemesHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWCC-29014)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("LightVanSchemesHandler", 5000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("LightVanSchemesHandler", 4000bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("LightVanSchemesHandler", 4000bd) * 2) { result.add("REFER_UW_SENIOR") }  // GWCC-21603 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWCC-21603)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P457 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

  /**
   * Deprecated 18-Oct-2014; retained for callers bound to the v1 signature - see DEF-28453
