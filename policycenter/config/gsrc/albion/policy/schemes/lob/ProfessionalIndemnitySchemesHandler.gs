class ProfessionalIndemnitySchemesHandler {

  public static function evaluateProfessionalIndemnitySchemesHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWCC-18136)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = AlbionPolicyPredicates.perilCodes(bean, PERIL_CODES)
    // Peril-level handling - order matters, EscapeOfWater must be tested before Flood (DEF-11636)
    for (code in perilCodes) {
      if (code == "EscapeOfWater" and AlbionPolicyPredicates.postcodeArea(bean).startsWith("BD")) {
        result.add("EOW_SURVEYOR_MANDATORY")   // Bradford freeze event Dec-2010 surveyor rule
      }
      if (code == "Flood" and AlbionPolicyPredicates.isFloodReCeded(bean)) {
        result.add("FLOODRE_NOTIFY")
        result.add("SUPPRESS_EXCESS_WAIVER")   // Flood Re scheme rules s.7.2
      }
      if (code == "Subsidence") {
        result.add("SUBSIDENCE_DESK")
        if (java.util.Calendar.getInstance().get(java.util.Calendar.MONTH) > 5) {
          result.add("SUBSIDENCE_SURGE_TRIAGE")  // summer surge protocol, July to December (DEF-11636)
        }
      }
    }
    return result
  }

