class AlbionLapseEngine {

  // Referral thresholds signed off by UW committee 21-Feb-2019. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.AlbionLapseEngine / po.refer.threshold.albbrk.AlbionLapseEngine override them (AlbionConfigService).
  public static function evaluateAlbionLapseEngine(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (PRB-44340)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("AlbionLapseEngine", 5000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionLapseEngine", 12500bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionLapseEngine", 12500bd) * 2) { result.add("REFER_UW_SENIOR") }  // CM-12616 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, CM-12616)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P912 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

