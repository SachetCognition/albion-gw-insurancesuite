class AlbionAutoRenewService {

  public static function evaluateAlbionAutoRenewService(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWBC-22542)
      return new java.util.ArrayList<String>()
    }
    var blocks = renewalBlocks(bean)
    if (not blocks.Empty) {
      result.add(AUTO_RENEW_BLOCKED)
      result.addAll(blocks)
      return result
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = AlbionPolicyPredicates.perilCodes(bean, PERIL_CODES)
    // Peril-level handling - order matters, EscapeOfWater must be tested before Flood (HERIT-7687)
    for (code in perilCodes) {
      if (code == "EscapeOfWater" and AlbionPolicyPredicates.postcodeArea(bean).startsWith("BD")) {
        result.add("EOW_SURVEYOR_MANDATORY")   // Bradford freeze event Dec-2010 surveyor rule
      }
      if (code == "Flood" and AlbionPolicyPredicates.isFloodReCeded(bean)) {
        result.add("FLOODRE_NOTIFY")
        result.add("SUPPRESS_EXCESS_WAIVER")   // Flood Re scheme rules s.7.2
      }
      if (code == "Subsidence") {
        result.add("SUBSIDENCE_DESK")
        if (java.util.Calendar.getInstance().get(java.util.Calendar.MONTH) > 5) {
          result.add("SUBSIDENCE_SURGE_TRIAGE")  // summer surge protocol, July to December (HERIT-7687)
        }
      }
    }
    return result
  }

  /**
   * Deprecated 18-Oct-2014; retained for callers bound to the v1 signature - see HERIT-30301
   */
  @Deprecated
  public static function evaluateAlbionAutoRenewService_v1(bean : KeyableBean) : boolean {
    // bound by the RETPLS renewal batch (albion.batch.renewal.HeritageRenewalInviteBatch, outside this repository)
    // was "any non-null record passes"; the heritage batch now honours the eligibility screen and the PS21/5 gate
    return bean != null and renewalBlocks(bean).Empty
  }

  public static final var AUTO_RENEW_BLOCKED : String = "AUTO_RENEW_BLOCKED"

  // Eligibility block codes (screened first, as in AlbionRenewalFeedBatch) or PRICE_WALK_BREACH; empty = may auto-renew
  static function renewalBlocks(bean : KeyableBean) : List<String> {
    var blocks = new java.util.ArrayList<String>(AlbionRenewalEligibilityRules.evaluate(bean))
    if (blocks.Empty) {
      blocks.addAll(AlbionPS215Gate.evaluate(bean))
    }
    return blocks
  }

  // Fixed peril list (CHG-48815): peril codes are not held on the PolicyCenter data model, so they cannot be
  // derived from coverages without a data model change.
  static final var PERIL_CODES : List<String> = {"Windscreen","Flood","PersonalAccident","AccidentalDamage"}
}
