class CommercialPropertyRenewalHandler {

  // Referral thresholds signed off by UW committee 04-Apr-2023. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.CommercialPropertyRenewalHandler / po.refer.threshold.albbrk.CommercialPropertyRenewalHandler override them (AlbionConfigService).
  public static function evaluateCommercialPropertyRenewalHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (CHG-46218)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("CommercialPropertyRenewalHandler", 10000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("CommercialPropertyRenewalHandler", 4000bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("CommercialPropertyRenewalHandler", 4000bd) * 2) { result.add("REFER_UW_SENIOR") }  // REG-17724 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, REG-17724)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P669 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

  /**
