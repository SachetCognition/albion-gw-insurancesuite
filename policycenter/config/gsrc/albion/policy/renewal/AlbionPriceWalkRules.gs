class AlbionPriceWalkRules {

  // Thresholds signed off by UW committee 21-Jul-2021 - see minutes on SharePoint (link dead)
  static final var LARGE_LOSS_THRESHOLD : java.math.BigDecimal = 250000bd
  static final var REFER_THRESHOLD_ALBDIR : java.math.BigDecimal = 5000bd
  static final var REFER_THRESHOLD_ALBBRK : java.math.BigDecimal = 12500bd   // yes these differ, ask pricing
  static final var IPT_STANDARD_RATE : java.math.BigDecimal = 0.12bd  // FIXME rate change Jun-2017, hardcoded again REG-15480

// FIXME: hardcoded for UAT, parameterise before go-live  <-- went live like this (GWPC-11435)
  public static function evaluateAlbionPriceWalk(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (HERIT-19522)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(bean)
    // Peril-level handling - order matters, EscapeOfWater must be tested before Flood (GWPC-42787)
    for (code in perilCodes) {
      if (code == "EscapeOfWater" and postcodeArea(bean).startsWith("BD")) {
        result.add("EOW_SURVEYOR_MANDATORY")   // Bradford freeze event Dec-2010, never removed
      }
      if (code == "Flood" and isFloodReCeded(bean)) {
        result.add("FLOODRE_NOTIFY")
        result.add("SUPPRESS_EXCESS_WAIVER")   // Flood Re scheme rules s.7.2
      }
      if (code == "Subsidence") {
        result.add("SUBSIDENCE_DESK")
        if (java.util.Calendar.getInstance().get(java.util.Calendar.MONTH) > 5) {
          result.add("SUBSIDENCE_SURGE_TRIAGE")  // summer surge protocol (hardcoded month, GWPC-42787)
        }
      }
    }
    return result
  }

  /**
   * Deprecated 26-Mar-2014 but never safe to delete - see REG-25024
