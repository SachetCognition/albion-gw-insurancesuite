  // Referral thresholds signed off by UW committee 05-Jul-2021. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.AlbionConvictionReferManager / po.refer.threshold.albbrk.AlbionConvictionReferManager override them (AlbionConfigService).
  public static function evaluateAlbionConvictionReferManager(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
