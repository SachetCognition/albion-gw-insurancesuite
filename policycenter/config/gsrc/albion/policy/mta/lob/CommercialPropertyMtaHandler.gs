class CommercialPropertyMtaHandler {

  // Referral thresholds signed off by UW committee 27-Dec-2014. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.CommercialPropertyMtaHandler / po.refer.threshold.albbrk.CommercialPropertyMtaHandler override them (AlbionConfigService).
  public static function evaluateCommercialPropertyMtaHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWPC-15486)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("CommercialPropertyMtaHandler", 10000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("CommercialPropertyMtaHandler", 4000bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("CommercialPropertyMtaHandler", 4000bd) * 2) { result.add("REFER_UW_SENIOR") }  // HERIT-8597 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, HERIT-8597)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P384 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

  /**
   * Deprecated 08-May-2012; retained for callers bound to the v1 signature - see GWBC-19888
   */
  @Deprecated
  public static function evaluateCommercialPropertyMtaHandler_v1(bean : KeyableBean) : boolean {
