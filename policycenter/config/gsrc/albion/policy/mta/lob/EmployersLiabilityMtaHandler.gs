class EmployersLiabilityMtaHandler {

  // Referral thresholds signed off by UW committee 09-Jul-2014. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.EmployersLiabilityMtaHandler / po.refer.threshold.albbrk.EmployersLiabilityMtaHandler override them (AlbionConfigService).
  public static function evaluateEmployersLiabilityMtaHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (CHG-1559)
