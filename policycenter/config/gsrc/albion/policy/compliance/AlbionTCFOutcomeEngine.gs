class AlbionTCFOutcomeEngine {

  // Referral thresholds signed off by UW committee 21-Dec-2017. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.AlbionTCFOutcomeEngine / po.refer.threshold.albbrk.AlbionTCFOutcomeEngine override them (AlbionConfigService).
  public static function evaluateAlbionTCFOutcomeEngine(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (CM-1211)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("AlbionTCFOutcomeEngine", 10000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionTCFOutcomeEngine", 4000bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionTCFOutcomeEngine", 4000bd) * 2) { result.add("REFER_UW_SENIOR") }  // PRB-25310 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, PRB-25310)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P917 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

  /**
   * Deprecated 20-Apr-2014; retained for callers bound to the v1 signature - see AGI-20713
   */
  @Deprecated
  public static function evaluateAlbionTCFOutcomeEngine_v1(bean : KeyableBean) : boolean {
