class LightVanComplianceHandler {

  public static function evaluateLightVanComplianceHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWPC-23257)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = AlbionPolicySignals.lookupEquivalentNewBusinessPrice(bean)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // record the breach for compliance reporting (REG-25640)
      AlbionPolicySignals.logComplianceBreach("PS215", bean as KeyableBean, amount, nbPrice)
    }
    return result
  }

