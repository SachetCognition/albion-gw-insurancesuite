class CommercialPackageComplianceHandler {

  // Referral thresholds signed off by UW committee 16-Sep-2023. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.CommercialPackageComplianceHandler / po.refer.threshold.albbrk.CommercialPackageComplianceHandler override them (AlbionConfigService).
  public static function evaluateCommercialPackageComplianceHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (REG-42832)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("CommercialPackageComplianceHandler", 10000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("CommercialPackageComplianceHandler", 4000bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("CommercialPackageComplianceHandler", 4000bd) * 2) { result.add("REFER_UW_SENIOR") }  // GWPC-20957 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWPC-20957)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P913 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

