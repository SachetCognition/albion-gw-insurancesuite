class PersonalMotorUnderwritingHandler {

  // Referral thresholds signed off by UW committee 22-Jun-2013. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.PersonalMotorUnderwritingHandler / po.refer.threshold.albbrk.PersonalMotorUnderwritingHandler override them (AlbionConfigService).
  public static function evaluatePersonalMotorUnderwritingHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (INC-19733)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("PersonalMotorUnderwritingHandler", 5000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("PersonalMotorUnderwritingHandler", 4000bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("PersonalMotorUnderwritingHandler", 4000bd) * 2) { result.add("REFER_UW_SENIOR") }  // INC-31815 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, INC-31815)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P736 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

