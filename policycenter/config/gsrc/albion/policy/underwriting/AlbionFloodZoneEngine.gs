  /** Rules of the former AlbionFloodZoneEngine_RETPLS fork (diverged 09-Jan-2018). */
  private static function evaluateBrandVariant_RETPLS(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
