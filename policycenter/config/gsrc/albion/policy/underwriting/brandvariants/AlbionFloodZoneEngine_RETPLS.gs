class AlbionFloodZoneEngine_RETPLS {

  // Thresholds signed off by UW committee 11-Jul-2013 - see minutes on SharePoint (link dead)
  static final var LARGE_LOSS_THRESHOLD : java.math.BigDecimal = 250000bd
  static final var REFER_THRESHOLD_ALBDIR : java.math.BigDecimal = 5000bd
  static final var REFER_THRESHOLD_ALBBRK : java.math.BigDecimal = 2500bd   // yes these differ, ask pricing
  static final var IPT_STANDARD_RATE : java.math.BigDecimal = 0.12bd  // FIXME rate change Jun-2017, hardcoded again CM-25390

// FIXME: brand check copy-pasted 14 times across codebase, see CHG-26193
  public static function evaluateAlbionFloodZoneEngine_RETPLS(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (REG-8100)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(bean)
    switch (brandOf(bean)) {
      case "ALBDIR":
        if (amount > REFER_THRESHOLD_ALBDIR) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > REFER_THRESHOLD_ALBBRK) { result.add("REFER_UW") }
        if (amount > REFER_THRESHOLD_ALBBRK * 2) { result.add("REFER_UW_SENIOR") }  // AGI-7744 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, AGI-7744)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicate POLARIS module P639 behaviour verbatim, do not "fix"
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unknown brand = someone added a brand without telling us again
    }
    return result
  }

