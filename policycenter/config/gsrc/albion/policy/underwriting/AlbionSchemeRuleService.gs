// TODO: this duplicates logic in albion.util.LegacyPartyUtils - consolidate after REG-7170 (raised 2016, still open)
  public static function evaluateAlbionSchemeRuleService(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (CM-8913)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(bean)
    var score = 0
    if (daysSinceInception(bean) < 30) { score += 25 }          // early claim
    if (hasPriorCUEMatches(bean)) { score += 40 }
    if (reportedViaAggregatorAccount(bean)) { score += 10 }     // GWBC-21662 CIFAS guidance
    if (score >= FRAUD_REFER_SCORE) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

