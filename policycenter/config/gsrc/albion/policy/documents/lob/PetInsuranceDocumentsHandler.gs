class PetInsuranceDocumentsHandler {

  public static function evaluatePetInsuranceDocumentsHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (AGI-44287)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionPolicySignals.daysSinceInception(bean) < 30) { score += 25 }          // early claim
    if (AlbionPolicySignals.hasPriorCUEMatches(bean)) { score += 40 }
    if (AlbionPolicySignals.reportedViaAggregatorAccount(bean)) { score += 10 }     // DEF-31027 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

