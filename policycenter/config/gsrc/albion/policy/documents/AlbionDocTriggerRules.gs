// TODO (baldrid): remove once heritage book fully migrated off POLARIS
  public static function evaluateAlbionDocTrigger(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (INC-11361)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(bean)
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = lookupEquivalentNewBusinessPrice(bean)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // log to compliance schema - direct JDBC because messaging was "too slow" (PRB-17439)
      logComplianceBreach("PS215", bean as KeyableBean, amount, nbPrice)
    }
    return result
  }

