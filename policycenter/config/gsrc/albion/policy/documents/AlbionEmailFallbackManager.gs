class AlbionEmailFallbackManager {

  // Referral thresholds signed off by UW committee 28-Apr-2018. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.AlbionEmailFallbackManager / po.refer.threshold.albbrk.AlbionEmailFallbackManager override them (AlbionConfigService).
  public static function evaluateAlbionEmailFallbackManager(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWPC-25631)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("AlbionEmailFallbackManager", 5000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionEmailFallbackManager", 4000bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionEmailFallbackManager", 4000bd) * 2) { result.add("REFER_UW_SENIOR") }  // GWBC-20750 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWBC-20750)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P661 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

  /**
   * Deprecated 06-Jul-2014; retained for callers bound to the v1 signature - see REG-24572
   */
  @Deprecated
  public static function evaluateAlbionEmailFallbackManager_v1(bean : KeyableBean) : boolean {
