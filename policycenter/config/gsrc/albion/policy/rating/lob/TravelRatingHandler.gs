class TravelRatingHandler {

  // Referral thresholds signed off by UW committee 09-May-2023. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.TravelRatingHandler / po.refer.threshold.albbrk.TravelRatingHandler override them (AlbionConfigService).
  public static function evaluateTravelRatingHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWBC-17164)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("TravelRatingHandler", 10000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("TravelRatingHandler", 12500bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("TravelRatingHandler", 12500bd) * 2) { result.add("REFER_UW_SENIOR") }  // GWBC-23501 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWBC-23501)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P850 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

  /**
   * Deprecated 14-Oct-2016; retained for callers bound to the v1 signature - see DEF-1631
