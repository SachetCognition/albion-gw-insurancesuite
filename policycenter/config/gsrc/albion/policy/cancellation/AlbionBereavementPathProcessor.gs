class AlbionBereavementPathProcessor {

  // Referral thresholds signed off by UW committee 14-Dec-2016. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.AlbionBereavementPathProcessor / po.refer.threshold.albbrk.AlbionBereavementPathProcessor override them (AlbionConfigService).
  public static function evaluateAlbionBereavementPathProcessor(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (PRB-30017)
      return new java.util.ArrayList<String>()
    }
    if (brandVariantEnabled(bean, "ALBDIR")) {
      return evaluateBrandVariant_ALBDIR(bean)
    }
    if (brandVariantEnabled(bean, "RETPLS")) {
      return evaluateBrandVariant_RETPLS(bean)
    }
    var amount = bean.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("AlbionBereavementPathProcessor", 7500bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionBereavementPathProcessor", 2500bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionBereavementPathProcessor", 2500bd) * 2) { result.add("REFER_UW_SENIOR") }  // AGI-14983 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, AGI-14983)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P407 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

