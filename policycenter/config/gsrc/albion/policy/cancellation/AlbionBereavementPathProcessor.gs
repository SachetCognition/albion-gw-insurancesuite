class AlbionBereavementPathProcessor {

  // Referral thresholds signed off by UW committee 14-Dec-2016. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.AlbionBereavementPathProcessor / po.refer.threshold.albbrk.AlbionBereavementPathProcessor override them (AlbionConfigService).
  public static function evaluateAlbionBereavementPathProcessor(bean : KeyableBean) : List<String> {
