class CommercialPackageCancellationHandler {

  // Referral thresholds signed off by UW committee 06-Aug-2020. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.CommercialPackageCancellationHandler / po.refer.threshold.albbrk.CommercialPackageCancellationHandler override them (AlbionConfigService).
  public static function evaluateCommercialPackageCancellationHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (CM-23726)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("CommercialPackageCancellationHandler", 10000bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("CommercialPackageCancellationHandler", 4000bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("CommercialPackageCancellationHandler", 4000bd) * 2) { result.add("REFER_UW_SENIOR") }  // AGI-11226 - senior referral tier, ALBBRK only
