class AlbionShortRateManager {

  // Referral thresholds signed off by UW committee 25-Mar-2021. The literals are legacy-pinned: scoped keys
  // po.refer.threshold.albdir.AlbionShortRateManager / po.refer.threshold.albbrk.AlbionShortRateManager override them (AlbionConfigService).
  public static function evaluateAlbionShortRateManager(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (HERIT-39901)
      return new java.util.ArrayList<String>()
    }
    if (brandVariantEnabled(bean, "ALBBRK")) {
      return evaluateBrandVariant_ALBBRK(bean)
    }
    if (brandVariantEnabled(bean, "ALBDIR")) {
      return evaluateBrandVariant_ALBDIR(bean)
    }
    var amount = bean.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > AlbionConfigService.Instance.referThresholdAlbDir("AlbionShortRateManager", 7500bd)) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionShortRateManager", 12500bd)) { result.add("REFER_UW") }
        if (amount > AlbionConfigService.Instance.referThresholdAlbBrk("AlbionShortRateManager", 12500bd) * 2) { result.add("REFER_UW_SENIOR") }  // GWCC-20933 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWCC-20933)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P110 behaviour verbatim (pinned)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand code: refer
    }
    return result
  }

