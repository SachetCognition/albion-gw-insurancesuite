package rules.Escalation

@gw.rules.RuleName("PolicyEscalationRules")
@gw.rules.RuleSetDescription("Escalates policy periods whose outbound feed needs attention. Rules run in legacy priority order (highest first); each queues the period for the outbound feed and raises a review activity.")
@gw.lang.Export
class PolicyEscalationRules extends gw.rules.RuleSetBase {
  static function invoke(bean : entity.PolicyPeriod) : gw.rules.ExecutionSession {
    return invoke( new gw.rules.ExecutionSession(), bean )
  }

  static function invoke(exeSession : gw.rules.ExecutionSession, bean : entity.PolicyPeriod) : gw.rules.ExecutionSession {
    return _invoke( exeSession, bean, "PolicyEscalationRules", PolicyEscalationRules)
  }
}
