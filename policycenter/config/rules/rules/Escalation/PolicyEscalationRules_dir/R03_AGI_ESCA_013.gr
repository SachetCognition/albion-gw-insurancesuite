package rules.Escalation.PolicyEscalationRules_dir

uses albion.util.AlbionActivityUtils

@gw.rules.RuleName("AGI_ESCA_013 - Queue ALBDIR brand policy periods for review")
internal class R03_AGI_ESCA_013 {
  static function doCondition(policyPeriod : entity.PolicyPeriod) : boolean {
/*start00rule*/
return policyPeriod.BrandCode_Ext == BrandCode_Ext.TC_ALBDIR
/*end00rule*/
}

  static function doAction(policyPeriod : entity.PolicyPeriod, actions : gw.rules.Action) {
/*start00rule*/
policyPeriod.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(policyPeriod, "review_agi_esca_013", "Review policy - brand ALBDIR")
/*end00rule*/
  }
}
