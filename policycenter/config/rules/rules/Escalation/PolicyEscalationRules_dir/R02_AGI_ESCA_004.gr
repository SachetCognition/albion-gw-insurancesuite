package rules.Escalation.PolicyEscalationRules_dir

uses albion.util.AlbionActivityUtils

@gw.rules.RuleName("AGI_ESCA_004 - Queue ALBDIR brand, POLARIS-migrated policy periods for review")
internal class R02_AGI_ESCA_004 {
  static function doCondition(policyPeriod : entity.PolicyPeriod) : boolean {
/*start00rule*/
return policyPeriod.BrandCode_Ext == BrandCode_Ext.TC_ALBDIR and
       policyPeriod.SourceSystem_Ext == "POLARIS"
/*end00rule*/
}

  static function doAction(policyPeriod : entity.PolicyPeriod, actions : gw.rules.Action) {
/*start00rule*/
policyPeriod.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(policyPeriod, "review_agi_esca_004", "Queue ALBDIR brand, POLARIS-migrated policy periods for revi")
/*end00rule*/
  }
}
