package rules.Validation

@gw.rules.RuleName("PolicyValidationRules")
@gw.rules.RuleSetDescription("Flags policy periods whose brand, source system or feed state needs review. Rules run in legacy priority order (highest first); each queues the period for the outbound feed and raises a review activity.")
@gw.lang.Export
class PolicyValidationRules extends gw.rules.RuleSetBase {
  static function invoke(bean : entity.PolicyPeriod) : gw.rules.ExecutionSession {
    return invoke( new gw.rules.ExecutionSession(), bean )
  }

  static function invoke(exeSession : gw.rules.ExecutionSession, bean : entity.PolicyPeriod) : gw.rules.ExecutionSession {
    return _invoke( exeSession, bean, "PolicyValidationRules", PolicyValidationRules)
  }
}
