package rules.Validation.PolicyValidationRules_dir

uses albion.util.AlbionActivityUtils

@gw.rules.RuleName("AGI_VALI_010 - Queue ALBBRK brand, POLARIS-migrated policy periods for review")
internal class R01_AGI_VALI_010 {
  static function doCondition(policyPeriod : entity.PolicyPeriod) : boolean {
/*start00rule*/
return policyPeriod.BrandCode_Ext == BrandCode_Ext.TC_ALBBRK and
       policyPeriod.SourceSystem_Ext == "POLARIS"
/*end00rule*/
}

  static function doAction(policyPeriod : entity.PolicyPeriod, actions : gw.rules.Action) {
/*start00rule*/
policyPeriod.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(policyPeriod, "review_agi_vali_010", "Queue ALBBRK brand, POLARIS-migrated policy periods for revi")
/*end00rule*/
  }
}
