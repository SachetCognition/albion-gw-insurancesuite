package rules.Validation.PolicyValidationRules_dir

uses albion.util.AlbionActivityUtils

@gw.rules.RuleName("AGI_VALI_004 - Queue HERIT brand policy periods for review")
internal class R03_AGI_VALI_004 {
  static function doCondition(policyPeriod : entity.PolicyPeriod) : boolean {
/*start00rule*/
return policyPeriod.BrandCode_Ext == BrandCode_Ext.TC_HERIT
/*end00rule*/
}

  static function doAction(policyPeriod : entity.PolicyPeriod, actions : gw.rules.Action) {
/*start00rule*/
policyPeriod.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(policyPeriod, "review_agi_vali_004", "Review policy - heritage book (HERIT)")
/*end00rule*/
  }
}
