package rules.Validation.PolicyValidationRules_dir

uses albion.util.AlbionActivityUtils

@gw.rules.RuleName("AGI_VALI_006 - Queue POLARIS-migrated policy periods for review")
internal class R02_AGI_VALI_006 {
  static function doCondition(policyPeriod : entity.PolicyPeriod) : boolean {
/*start00rule*/
return policyPeriod.SourceSystem_Ext == "POLARIS"
/*end00rule*/
}

  static function doAction(policyPeriod : entity.PolicyPeriod, actions : gw.rules.Action) {
/*start00rule*/
policyPeriod.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(policyPeriod, "review_agi_vali_006", "Review policy - migrated from POLARIS")
/*end00rule*/
  }
}
