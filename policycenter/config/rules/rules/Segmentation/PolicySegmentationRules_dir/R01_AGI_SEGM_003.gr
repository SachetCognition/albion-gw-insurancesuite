package rules.Segmentation.PolicySegmentationRules_dir

uses albion.util.AlbionActivityUtils

@gw.rules.RuleName("AGI_SEGM_003 - Queue POLARIS-migrated, feed not PENDING policy periods for review")
internal class R01_AGI_SEGM_003 {
  static function doCondition(policyPeriod : entity.PolicyPeriod) : boolean {
/*start00rule*/
return policyPeriod.SourceSystem_Ext == "POLARIS" and
       policyPeriod.FeedStatus_Ext != "PENDING"
/*end00rule*/
}

  static function doAction(policyPeriod : entity.PolicyPeriod, actions : gw.rules.Action) {
/*start00rule*/
policyPeriod.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(policyPeriod, "review_agi_segm_003", "Queue POLARIS-migrated, feed not PENDING policy periods for ")
/*end00rule*/
  }
}
