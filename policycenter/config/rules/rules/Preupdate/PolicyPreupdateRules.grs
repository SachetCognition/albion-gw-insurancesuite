package rules.Preupdate

@gw.rules.RuleName("PolicyPreupdateRules")
@gw.rules.RuleSetDescription("Re-queues policy periods for the outbound feed before commit. Rules run in legacy priority order (highest first); each queues the period for the outbound feed and raises a review activity.")
@gw.lang.Export
class PolicyPreupdateRules extends gw.rules.RuleSetBase {
  static function invoke(bean : entity.PolicyPeriod) : gw.rules.ExecutionSession {
    return invoke( new gw.rules.ExecutionSession(), bean )
  }

  static function invoke(exeSession : gw.rules.ExecutionSession, bean : entity.PolicyPeriod) : gw.rules.ExecutionSession {
    return _invoke( exeSession, bean, "PolicyPreupdateRules", PolicyPreupdateRules)
  }
}
