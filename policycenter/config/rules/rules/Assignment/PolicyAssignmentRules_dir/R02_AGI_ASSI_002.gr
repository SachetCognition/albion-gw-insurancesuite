package rules.Assignment.PolicyAssignmentRules_dir

uses albion.util.AlbionActivityUtils

@gw.rules.RuleName("AGI_ASSI_002 - Queue feed not PENDING policy periods for review")
internal class R02_AGI_ASSI_002 {
  static function doCondition(policyPeriod : entity.PolicyPeriod) : boolean {
/*start00rule*/
return policyPeriod.FeedStatus_Ext != "PENDING"
/*end00rule*/
}

  static function doAction(policyPeriod : entity.PolicyPeriod, actions : gw.rules.Action) {
/*start00rule*/
policyPeriod.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(policyPeriod, "review_agi_assi_002", "Queue feed not PENDING policy periods for review")
/*end00rule*/
  }
}
