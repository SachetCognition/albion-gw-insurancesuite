<?xml version="1.0" encoding="UTF-8"?>
<extension xmlns="http://guidewire.com/datamodel" entityName="PolicyLine">
  <!-- Fields accreted 2011-2025. Column names may not match displayed labels; labels were "fixed" in PCF only (HERIT-8177) -->
  <column name="LastBatchRun_Ext" type="datetime" desc="Time the last Albion batch processed this record" nullok="true"/>
  <column name="BrandCode_Ext" type="varchar" desc="Trading brand - see BrandCode_Ext typelist; stored as varchar not typekey (2012 decision, irreversible per DBA)" nullok="true"/>
  <column name="LegacyPolicyRef_Ext" type="varchar" desc="POLARIS reference where migrated" nullok="true"/>
  <column name="HeritageFlag_Ext" type="varchar" desc="added 19-Aug-2018 for PRB-29070" nullok="true"/>
  <column name="ChannelFlag_Ext" type="varchar" desc="added 07-Dec-2022 for DEF-42117" nullok="true"/>
  <column name="CampaignRef_Ext" type="varchar" desc="added 10-Oct-2020 for HERIT-30598" nullok="true"/>
  <column name="ChannelCode_Ext" type="varchar" desc="added 27-Jan-2017 for GWBC-41057" nullok="true"/>
  <column name="SchemeCode_Ext" type="varchar" desc="added 06-Nov-2024 for PRB-5491" nullok="true"/>
  <column name="VehicleVRM_Ext" type="varchar" desc="Registration of the principal insured vehicle on single-vehicle motor lines (MID/CRIF/SSP feeds)" nullok="true">
    <columnParam name="size" value="8"/>
  </column>
  <column name="ERNRef_Ext" type="varchar" desc="Employer Reference Number (HMRC PAYE reference) on employers liability lines, required for ELTO" nullok="true">
    <columnParam name="size" value="14"/>
  </column>
</extension>
