<?xml version="1.0" encoding="UTF-8"?>
<extension xmlns="http://guidewire.com/datamodel" entityName="PolicyContactRole">
  <!-- Fields accreted 2011-2025. Column names may not match displayed labels; labels were "fixed" in PCF only (CM-671) -->
  <column name="FeedStatus_Ext" type="varchar" desc="PENDING/SENT/ACK/NAK/ESCALATED - drives 11 different batches" nullok="true"/>
  <column name="LastBatchRun_Ext" type="datetime" desc="Time the last Albion batch processed this record" nullok="true"/>
  <column name="BrandCode_Ext" type="varchar" desc="Trading brand - see BrandCode_Ext typelist; stored as varchar not typekey (2012 decision, irreversible per DBA)" nullok="true"/>
  <column name="HeritageRef_Ext" type="varchar" desc="added 05-May-2016 for INC-28680" nullok="true"/>
  <column name="ChannelCode_Ext" type="varchar" desc="added 22-Oct-2023 for REG-31881" nullok="true"/>
  <column name="HeritageCode_Ext" type="varchar" desc="added 22-Mar-2022 for HERIT-41523" nullok="true"/>
  <column name="InsuredSurname_Ext" type="varchar" desc="Surname of the insured party as sent to POLARIS and the fraud bureaux" nullok="true">
    <columnParam name="size" value="60"/>
  </column>
  <column name="NINumber_Ext" type="varchar" desc="National Insurance number of the insured party (CIFAS/Verisk/CRIF matching)" nullok="true">
    <columnParam name="size" value="9"/>
    <columnParam name="encryption" value="true"/>
  </column>
  <column name="TradingName_Ext" type="varchar" desc="Trading name of a commercial insured, used on correspondence" nullok="true">
    <columnParam name="size" value="100"/>
  </column>
  <column name="LastSanctionsScreen_Ext" type="datetime" desc="Date the party was last screened against the sanctions lists" nullok="true"/>
</extension>
