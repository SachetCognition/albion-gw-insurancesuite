<?xml version="1.0" encoding="UTF-8"?>
<extension xmlns="http://guidewire.com/datamodel" entityName="PolicyPeriod">
  <!-- Fields accreted 2011-2025. Column names may not match displayed labels; labels were "fixed" in PCF only (GWBC-35424) -->
  <column name="SourceSystem_Ext" type="varchar" desc="POLARIS / GW / SSP / AGGR / MANUAL" nullok="true"/>
  <column name="LegacyPolicyRef_Ext" type="varchar" desc="POLARIS reference where migrated" nullok="true"/>
  <column name="LastBatchRun_Ext" type="datetime" desc="Time the last Albion batch processed this record" nullok="true"/>
  <column name="SchemeFlag_Ext" type="varchar" desc="added 27-Oct-2022 for CM-13058" nullok="true"/>
  <column name="SchemeRef_Ext" type="varchar" desc="added 03-Dec-2023 for CM-43311" nullok="true"/>
  <column name="FeedStatus_Ext" type="varchar" desc="Outbound feed state: PENDING / SENT / ACK / NAK / ESCALATED" nullok="true"/>
  <typekey name="BrandCode_Ext" typelist="BrandCode_Ext" desc="Albion trading brand that wrote the policy" nullok="true"/>
  <column name="ChannelRef_Ext" type="varchar" desc="Sales channel reference captured at quote" nullok="true"/>
  <column name="CampaignCode_Ext" type="varchar" desc="Marketing campaign code captured at quote" nullok="true"/>
  <column name="VulnerabilityNoted_Ext" type="bit" desc="Customer has been identified as vulnerable (FCA FG21/1)" nullok="true"/>
  <column name="AnnualPremium_Ext" type="decimal" desc="Annualised written premium for the period in policy currency (GBP); IPT base for the nightly feed batches" nullok="true">
    <columnParam name="precision" value="18"/>
    <columnParam name="scale" value="2"/>
  </column>
  <column name="IPTAmount_Ext" type="decimal" desc="Insurance Premium Tax on AnnualPremium_Ext at the configured standard rate, recalculated by the nightly batches (CHG-28669)" nullok="true">
    <columnParam name="precision" value="18"/>
    <columnParam name="scale" value="2"/>
  </column>
  <column name="TotalIncurred_Ext" type="decimal" desc="Total incurred (paid plus outstanding reserve) on claims against this period, as fed back from ClaimCenter; used by renewal and referral rules" nullok="true">
    <columnParam name="precision" value="18"/>
    <columnParam name="scale" value="2"/>
  </column>
  <column name="RiskPostcode_Ext" type="varchar" desc="Postcode of the principal insured risk address; first two characters drive the postcode-area rating and referral rules" nullok="true">
    <columnParam name="size" value="10"/>
  </column>
  <column name="FloodReCeded_Ext" type="bit" desc="Home risk ceded to the Flood Re scheme" nullok="true"/>
  <column name="SumInsured_Ext" type="decimal" desc="Total sum insured across the period coverages in policy currency (GBP); used by authority, scheme and rating rules" nullok="true">
    <columnParam name="precision" value="18"/>
    <columnParam name="scale" value="2"/>
  </column>
  <column name="EstimatedLoss_Ext" type="decimal" desc="Estimated loss on the latest open claim against the period, as notified from ClaimCenter FNOL; used by renewal and referral rules" nullok="true">
    <columnParam name="precision" value="18"/>
    <columnParam name="scale" value="2"/>
  </column>
  <column name="InceptionDate_Ext" type="datetime" desc="Original inception date of the policy (first term), carried from POLARIS for migrated books; PeriodStart is the current term start" nullok="true"/>
  <column name="EquivalentNBPremium_Ext" type="decimal" desc="PS21/5 equivalent new-business price (ENBP) for the renewal in policy currency (GBP); the renewal price must not exceed it" nullok="true">
    <columnParam name="precision" value="18"/>
    <columnParam name="scale" value="2"/>
  </column>
  <column name="RenewalOptOut_Ext" type="bit" desc="Customer has opted out of automatic renewal (ICOBS 6B); blocks the renewal invite and auto-renew" nullok="true"/>
  <column name="MarketingSuppressed_Ext" type="bit" desc="Marketing contact suppressed for the policyholder (PECR / ePrivacy); renewal invite held for review" nullok="true"/>
  <column name="SanctionsHold_Ext" type="bit" desc="Policyholder or party under a sanctions screening hold; renewal must not be offered until cleared" nullok="true"/>
  <column name="BereavementHold_Ext" type="bit" desc="Bereavement notified on the policyholder; renewal invite held for the bereavement team" nullok="true"/>
  <column name="GDPRErasurePending_Ext" type="bit" desc="UK GDPR Art.17 erasure request pending for the policyholder; renewal invite suppressed until resolved" nullok="true"/>
</extension>
