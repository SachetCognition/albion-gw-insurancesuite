<?xml version="1.0" encoding="UTF-8"?>
<subtype xmlns="http://guidewire.com/datamodel" entity="BereavementWF_Ext" supertype="Workflow" desc="Bereavement handling - suppresses dunning (mostly)">
  <column name="CloseSensitiveEntered_Ext" type="datetime" desc="Time the workflow entered the CloseSensitive step" nullok="true"/>
  <column name="ExecutorVerifyEntered_Ext" type="datetime" desc="Time the workflow entered the ExecutorVerify step" nullok="true"/>
  <column name="FlagEntered_Ext" type="datetime" desc="Time the workflow entered the Flag step" nullok="true"/>
  <column name="PolicyDecisionEntered_Ext" type="datetime" desc="Time the workflow entered the PolicyDecision step" nullok="true"/>
  <column name="SuppressCommsEntered_Ext" type="datetime" desc="Time the workflow entered the SuppressComms step" nullok="true"/>
</subtype>
