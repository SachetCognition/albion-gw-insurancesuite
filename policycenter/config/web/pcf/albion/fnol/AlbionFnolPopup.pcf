<?xml version="1.0" encoding="UTF-8"?>
<!-- AlbionFnolPopup.pcf : cloned from the base OOTB screen and since diverged; not re-based during the v9->v10 upgrade (DEF-14853). -->
<PCF xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../pcf.xsd">
  <Popup
    id="AlbionFnolPopup"
    title="DisplayKey.get(&quot;Web.Albion.AlbionFnolPopup.Title&quot;)">
    <LocationEntryPoint
      signature="AlbionFnolPopup(PolicyPeriod : PolicyPeriod)"/>
    <Variable
      name="PolicyPeriod"
      type="PolicyPeriod"/>
    <Screen>
      <DetailViewPanel>
        <InputColumn>
            <TextInput
              editable="true"
              id="SchemeCode_Ext"
              label="&quot;SchemeCode&quot;"
              value="PolicyPeriod.SchemeCode_Ext"/>
            <TextInput
              editable="true"
              id="ChannelRef_Ext"
              label="&quot;ChannelRef&quot;"
              value="PolicyPeriod.ChannelRef_Ext"/>
            <TextInput
              editable="false"
              id="CampaignCode_Ext"
              label="&quot;CampaignCode&quot;"
              value="PolicyPeriod.CampaignCode_Ext"/>
            <TextInput
              editable="true"
              id="LegacyPolicyRef_Ext"
              label="&quot;LegacyPolicyRef&quot;"
              value="PolicyPeriod.LegacyPolicyRef_Ext"/>
          <BooleanRadioInput
            editable="true"
            id="VulnerableCustomerFlag"
            label="&quot;Vulnerable Customer (FG21/1)&quot;"
            value="PolicyPeriod.VulnerabilityNoted_Ext"/>
        </InputColumn>
        <InputColumn>
          <TypeKeyInput
            editable="false"
            id="BrandCode"
            label="&quot;Brand&quot;"
            value="PolicyPeriod.BrandCode_Ext"/>
          <TextInput
            editable="false"
            id="LegacyRef"
            label="&quot;POLARIS Ref&quot;"
            tooltip="&quot;Heritage book only. If populated, cross-check the mainframe before ANY financial change.&quot;"
            value="PolicyPeriod.LegacyPolicyRef_Ext"/>
        </InputColumn>
      </DetailViewPanel>
    </Screen>
  </Popup>
</PCF>
