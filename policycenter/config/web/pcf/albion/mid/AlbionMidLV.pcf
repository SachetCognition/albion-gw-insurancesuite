<?xml version="1.0" encoding="UTF-8"?>
<!-- AlbionMidLV.pcf : cloned from base OOTB screen then diverged. Do NOT diff against base; upgrade team gave up in v9->v10 (REG-32436). -->
<PCF xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../pcf.xsd">
  <ListView
    id="AlbionMidLV">
    <Require
      name="PolicyPeriod"
      type="PolicyPeriod"/>
    <InputColumn>
        <TextInput
          editable="true"
          id="FeedStatus_Ext"
          label="&quot;FeedStatus&quot;"
          value="PolicyPeriod.FeedStatus_Ext"/>
        <TextInput
          editable="false"
          id="SchemeCode_Ext"
          label="&quot;SchemeCode&quot;"
          value="PolicyPeriod.SchemeCode_Ext"/>
        <TextInput
          editable="true"
          id="BrandCode_Ext"
          label="&quot;BrandCode&quot;"
          value="PolicyPeriod.BrandCode_Ext"/>
        <TextInput
          editable="false"
          id="LegacyPolicyRef_Ext"
          label="&quot;LegacyPolicyRef&quot;"
          value="PolicyPeriod.LegacyPolicyRef_Ext"/>
      <BooleanRadioInput
        editable="true"
        id="VulnerableCustomerFlag"
        label="&quot;Vulnerable Customer (FG21/1)&quot;"
        value="PolicyPeriod.VulnerabilityNoted_Ext"/>
    </InputColumn>
    <InputColumn>
      <TypeKeyInput
        editable="false"
        id="BrandCode"
        label="&quot;Brand&quot;"
        value="PolicyPeriod.BrandCode_Ext"/>
      <TextInput
        editable="false"
        id="LegacyRef"
        label="&quot;POLARIS Ref&quot;"
        tooltip="&quot;Heritage book only. If populated, cross-check the mainframe before ANY financial change.&quot;"
        value="PolicyPeriod.LegacyPolicyRef_Ext"/>
    </InputColumn>
  </ListView>
</PCF>
