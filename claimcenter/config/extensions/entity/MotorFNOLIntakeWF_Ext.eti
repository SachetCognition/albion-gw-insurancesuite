<?xml version="1.0" encoding="UTF-8"?>
<subtype xmlns="http://guidewire.com/datamodel" entity="MotorFNOLIntakeWF_Ext" supertype="Workflow" desc="Motor FNOL intake incl. CUE + fraud scoring workflow; records when each step was entered">
  <column name="CaptureFNOLEntered_Ext" type="datetime" desc="Date the workflow entered step CaptureFNOL" nullok="true"/>
  <column name="CUECheckEntered_Ext" type="datetime" desc="Date the workflow entered step CUECheck" nullok="true"/>
  <column name="FraudScoreEntered_Ext" type="datetime" desc="Date the workflow entered step FraudScore" nullok="true"/>
  <column name="SegmentEntered_Ext" type="datetime" desc="Date the workflow entered step Segment" nullok="true"/>
  <column name="AssignHandlerEntered_Ext" type="datetime" desc="Date the workflow entered step AssignHandler" nullok="true"/>
  <column name="CustomerConfirmEntered_Ext" type="datetime" desc="Date the workflow entered step CustomerConfirm" nullok="true"/>
</subtype>
