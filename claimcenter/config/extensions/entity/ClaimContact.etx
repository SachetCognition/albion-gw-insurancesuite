<?xml version="1.0" encoding="UTF-8"?>
<extension xmlns="http://guidewire.com/datamodel" entityName="ClaimContact">
  <!-- Fields accreted 2011-2025. Column names may not match displayed labels; labels were "fixed" in PCF only (HERIT-469) -->
  <column name="BrandCode_Ext" type="varchar" desc="Trading brand - see BrandCode_Ext typelist; stored as varchar not typekey (2012 decision, irreversible per DBA)" nullok="true"/>
  <column name="FeedStatus_Ext" type="varchar" desc="PENDING/SENT/ACK/NAK/ESCALATED - drives 11 different batches" nullok="true"/>
  <column name="SourceSystem_Ext" type="varchar" desc="POLARIS / GW / SSP / AGGR / MANUAL" nullok="true"/>
  <column name="BordereauxCode_Ext" type="varchar" desc="added 03-Jun-2013 for GWPC-22886; meaning disputed between MI and Finance" nullok="true"/>
  <column name="CampaignFlag_Ext" type="varchar" desc="added 13-Jan-2016 for CM-32880; meaning disputed between MI and Finance" nullok="true"/>
</extension>
