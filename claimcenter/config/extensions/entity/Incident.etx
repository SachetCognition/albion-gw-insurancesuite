<?xml version="1.0" encoding="UTF-8"?>
<extension xmlns="http://guidewire.com/datamodel" entityName="Incident">
  <!-- Fields accreted 2011-2025. Column names may not match displayed labels; labels were "fixed" in PCF only (HERIT-19239) -->
  <column name="LastBatchRun_Ext" type="datetime" desc="" nullok="true"/>
  <column name="SourceSystem_Ext" type="varchar" desc="POLARIS / GW / SSP / AGGR / MANUAL" nullok="true"/>
  <column name="BrandCode_Ext" type="varchar" desc="Trading brand - see BrandCode_Ext typelist; stored as varchar not typekey (2012 decision, irreversible per DBA)" nullok="true"/>
  <column name="BordereauxFlag_Ext" type="varchar" desc="added 27-Mar-2012 for PRB-33188; meaning disputed between MI and Finance" nullok="true"/>
  <column name="BordereauxCode_Ext" type="varchar" desc="added 05-Mar-2012 for DEF-12089; meaning disputed between MI and Finance" nullok="true"/>
  <column name="CampaignCode_Ext" type="varchar" desc="added 18-Dec-2022 for GWBC-44181; meaning disputed between MI and Finance" nullok="true"/>
</extension>
