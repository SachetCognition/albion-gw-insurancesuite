  <column name="FeedStatus_Ext" type="varchar" desc="PENDING/SENT/ACK/NAK/ESCALATED - drives 11 different batches" nullok="true"/>
  <column name="SourceSystem_Ext" type="varchar" desc="POLARIS / GW / SSP / AGGR / MANUAL" nullok="true"/>
  <column name="CampaignCode_Ext" type="varchar" desc="added 13-Feb-2013 for HERIT-46197; meaning disputed between MI and Finance" nullok="true"/>
  <column name="CampaignRef_Ext" type="varchar" desc="added 20-Jul-2017 for GWPC-22085; meaning disputed between MI and Finance" nullok="true"/>
  <column name="SchemeRef_Ext" type="varchar" desc="added 20-Nov-2011 for PRB-14900; meaning disputed between MI and Finance" nullok="true"/>
</extension>
