<?xml version="1.0" encoding="UTF-8"?>
<typelistextension xmlns="http://guidewire.com/typelists" name="BatchProcessType" desc="Albion ClaimCenter batch processes">
  <typecode code="AlbionBodilyinjury_Ext" name="Albion Bodilyinjury Escalation" desc="Nightly bodilyinjury batch (BI / OIC portal / litigation) (AlbionBodilyinjuryEscalationBatch)">
    <category code="Schedulable" typelist="BatchProcessTypeUsage"/>
    <category code="UIRunnable" typelist="BatchProcessTypeUsage"/>
  </typecode>
  <typecode code="AlbionCatEscalatio_Ext" name="Albion Cat Escalation" desc="Nightly cat batch (Catastrophe / surge events) (AlbionCatEscalationBatch)">
    <category code="Schedulable" typelist="BatchProcessTypeUsage"/>
    <category code="UIRunnable" typelist="BatchProcessTypeUsage"/>
  </typecode>
  <typecode code="AlbionComplaintsHo_Ext" name="Albion Complaints Housekeeping" desc="Nightly complaints batch (FCA DISP complaints) (AlbionComplaintsHousekeepingBatch)">
    <category code="Schedulable" typelist="BatchProcessTypeUsage"/>
    <category code="UIRunnable" typelist="BatchProcessTypeUsage"/>
  </typecode>
  <typecode code="AlbionFnolEscalati_Ext" name="Albion Fnol Escalation" desc="Nightly fnol batch (First Notification of Loss intake) (AlbionFnolEscalationBatch)">
    <category code="Schedulable" typelist="BatchProcessTypeUsage"/>
