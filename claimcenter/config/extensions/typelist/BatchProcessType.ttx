  </typecode>
  <typecode code="AlbionPaymentsSwee_Ext" name="Albion Payments Sweep" desc="Nightly payments batch (Claim payments &amp; recoveries) (AlbionPaymentsSweepBatch)">
    <category code="Schedulable" typelist="BatchProcessTypeUsage"/>
    <category code="UIRunnable" typelist="BatchProcessTypeUsage"/>
  </typecode>
  <typecode code="AlbionShadowRecon_Ext" name="Albion Shadow Reconciliation" desc="Strangler shadow reconciliation report, unscheduled (AlbionShadowReconciliationBatch)">
