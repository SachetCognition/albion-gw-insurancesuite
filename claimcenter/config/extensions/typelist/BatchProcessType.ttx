  </typecode>
  <typecode code="AlbionReservesEsca_Ext" name="Albion Reserves Escalation" desc="Nightly reserves batch (Reserving &amp; authority) (AlbionReservesEscalationBatch)">
    <category code="Schedulable" typelist="BatchProcessTypeUsage"/>
    <category code="UIRunnable" typelist="BatchProcessTypeUsage"/>
  </typecode>
  <typecode code="AlbionSegmentation_Ext" name="Albion Segmentation Escalation" desc="Nightly segmentation batch (Claim segmentation &amp; routing) (AlbionSegmentationEscalationBatch)">
    <category code="Schedulable" typelist="BatchProcessTypeUsage"/>
