  </typecode>
  <typecode code="AlbionRecoveriesSw_Ext" name="Albion Recoveries Sweep" desc="Nightly recoveries batch (Recoveries &amp; reinsurance) (AlbionRecoveriesSweepBatch)">
    <category code="Schedulable" typelist="BatchProcessTypeUsage"/>
