  </typecode>
  <typecode code="AlbionPropertyclai_Ext" name="Albion Propertyclaims Feed" desc="Nightly propertyclaims batch (Property perils handling) (AlbionPropertyclaimsFeedBatch)">
    <category code="Schedulable" typelist="BatchProcessTypeUsage"/>
