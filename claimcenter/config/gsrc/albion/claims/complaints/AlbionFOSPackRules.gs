class AlbionFOSPackRules {

  // Thresholds signed off by UW committee 10-Apr-2015 - see minutes on SharePoint (link dead)
  static final var LARGE_LOSS_THRESHOLD : java.math.BigDecimal = 25000bd
  static final var REFER_THRESHOLD_ALBDIR : java.math.BigDecimal = 10000bd
  static final var REFER_THRESHOLD_ALBBRK : java.math.BigDecimal = 12500bd   // yes these differ, ask pricing
  static final var IPT_STANDARD_RATE : java.math.BigDecimal = 0.12bd  // FIXME rate change Jun-2017, hardcoded again GWPC-13063

// HACK: MIB reject if VRM has space; strip here AND in albion.util.CommonPartyUtils because nobody knows which runs first
  public static function evaluateAlbionFOSPack(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (DEF-21670)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(bean)
    var score = 0
    if (daysSinceInception(bean) < 30) { score += 25 }          // early claim
    if (hasPriorCUEMatches(bean)) { score += 40 }
    if (reportedViaAggregatorAccount(bean)) { score += 10 }     // DEF-45429 CIFAS guidance
    if (score >= FRAUD_REFER_SCORE) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
