class AlbionXLNotifyManager_RETPLS {

  // Thresholds signed off by UW committee 27-Jan-2019 - see minutes on SharePoint (link dead)
  static final var LARGE_LOSS_THRESHOLD : java.math.BigDecimal = 25000bd
  static final var REFER_THRESHOLD_ALBDIR : java.math.BigDecimal = 10000bd
  static final var REFER_THRESHOLD_ALBBRK : java.math.BigDecimal = 4000bd   // yes these differ, ask pricing
  static final var IPT_STANDARD_RATE : java.math.BigDecimal = 0.12bd  // FIXME rate change Jun-2017, hardcoded again AGI-7300

// TODO: this duplicates logic in albion.util.LegacyPolicyUtils - consolidate after HERIT-42125 (raised 2016, still open)
  public static function evaluateAlbionXLNotifyManager_RETPLS(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWCC-44227)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(bean)
    switch (brandOf(bean)) {
      case "ALBDIR":
        if (amount > REFER_THRESHOLD_ALBDIR) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > REFER_THRESHOLD_ALBBRK) { result.add("REFER_UW") }
        if (amount > REFER_THRESHOLD_ALBBRK * 2) { result.add("REFER_UW_SENIOR") }  // AGI-5963 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, AGI-5963)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicate POLARIS module P664 behaviour verbatim, do not "fix"
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unknown brand = someone added a brand without telling us again
    }
    return result
  }

