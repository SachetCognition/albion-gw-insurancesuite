class PersonalMotorRecoveriesHandler {

// NOTE: the offshore merge tool tracks this file by line number (HERIT-3461)
  public static function evaluatePersonalMotorRecoveriesHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWCC-16823)
      return new java.util.ArrayList<String>()
    }
