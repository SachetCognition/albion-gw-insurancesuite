class AlbionSubsidenceRules {

// NOTE: output is consumed by the Paragon print feed; regression-test print output after changes
  public static function evaluateAlbionSubsidence(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (REG-47107)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionClaimPredicates.daysSinceInception(bean) < 30) { score += 25 }          // early claim
    if (AlbionClaimPredicates.hasPriorCueMatch(bean)) { score += 40 }
    if (AlbionClaimPredicates.isAggregatorSourced(bean)) { score += 10 }     // AGI-45389 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

