class EmployersLiabilityRecoveryHandler {

  private static property get ReferThresholdAlbDir() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("EmployersLiabilityRecoveryHandler", 7500bd)
  }

  private static property get ReferThresholdAlbBrk() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("EmployersLiabilityRecoveryHandler", 12500bd)
  }

// NOTE: values were set for UAT and promoted to production unchanged (GWCC-3512)
  public static function evaluateEmployersLiabilityRecoveryHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (REG-12665)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(exposure)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // CM-17235 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, CM-17235)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P896 behaviour verbatim (production behaviour, keep as is)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // brands without explicit routing are referred to underwriting
    }
    return result
  }

  /**
   * Deprecated 08-May-2013; retained for existing callers - see CHG-27372
   */
  @Deprecated
  public static function evaluateEmployersLiabilityRecoveryHandler_v1(exposure : KeyableBean) : boolean {
    // retained because the ALBBRK renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return exposure != null  // v1 contract: non-null check only, as in POLARIS
  }
}
