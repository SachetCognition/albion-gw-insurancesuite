class TheftHomeSettlementHandler {

// NOTE: output is consumed by the Paragon print feed; regression-test print output after changes
  public static function evaluateTheftHomeSettlementHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (DEF-31569)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = ClaimRiskPredicates.equivalentNewBusinessPrice(exposure)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // record the breach for compliance reporting (PRB-35207)
      logComplianceBreach("PS215", exposure as KeyableBean, amount, nbPrice)
