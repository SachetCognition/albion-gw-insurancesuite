class FreezerRecoveryHandler {

  private static property get ReferThresholdAlbDir() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("FreezerRecoveryHandler", 5000bd)
  }

  private static property get ReferThresholdAlbBrk() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("FreezerRecoveryHandler", 4000bd)
  }

// NOTE: output is consumed by the Paragon print feed; regression-test print output after changes
  public static function evaluateFreezerRecoveryHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (REG-738)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(exposure)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // GWBC-8158 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWBC-8158)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P853 behaviour verbatim (production behaviour, keep as is)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // brands without explicit routing are referred to underwriting
    }
    return result
  }

  /**
   * Deprecated 18-Mar-2015; retained for existing callers - see INC-30825
   */
  @Deprecated
  public static function evaluateFreezerRecoveryHandler_v1(exposure : KeyableBean) : boolean {
    // retained because the ALBBRK renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return exposure != null  // v1 contract: non-null check only, as in POLARIS
  }
}
