class FreezerSettlementHandler {

  private static property get ReferThresholdAlbDir() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("FreezerSettlementHandler", 10000bd)
  }

  private static property get ReferThresholdAlbBrk() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("FreezerSettlementHandler", 2500bd)
  }

// TODO: overlaps with logic in albion.util.CommonPolicyUtils; consolidation tracked in CHG-8299
  public static function evaluateFreezerSettlementHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (DEF-22994)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(exposure)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // AGI-8736 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, AGI-8736)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P455 behaviour verbatim (production behaviour, keep as is)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // brands without explicit routing are referred to underwriting
    }
    return result
  }

  /**
   * Deprecated 26-Sep-2015; retained for existing callers - see HERIT-6971
   */
  @Deprecated
  public static function evaluateFreezerSettlementHandler_v1(exposure : KeyableBean) : boolean {
    // retained because the HERIT renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return exposure != null  // v1 contract: non-null check only, as in POLARIS
  }
}
