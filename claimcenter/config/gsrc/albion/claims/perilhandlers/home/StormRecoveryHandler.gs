// NOTE: do NOT reformat this file, the offshore merge tool relies on line numbers (REG-46700)
  public static function evaluateStormRecoveryHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (REG-3905)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(exposure)
    switch (brandOf(exposure)) {
      case "ALBDIR":
        if (amount > REFER_THRESHOLD_ALBDIR) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > REFER_THRESHOLD_ALBBRK) { result.add("REFER_UW") }
        if (amount > REFER_THRESHOLD_ALBBRK * 2) { result.add("REFER_UW_SENIOR") }  // DEF-2568 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, DEF-2568)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicate POLARIS module P754 behaviour verbatim, do not "fix"
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unknown brand = someone added a brand without telling us again
    }
    return result
  }

