class ThirdPartyPDReservingHandler {

// NOTE: values were set for UAT and promoted to production unchanged (HERIT-29448)
  public static function evaluateThirdPartyPDReservingHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWPC-19888)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (ClaimRiskPredicates.daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (ClaimRiskPredicates.hasPriorCUEMatches(exposure)) { score += 40 }
    if (ClaimRiskPredicates.reportedViaAggregatorAccount(exposure)) { score += 10 }     // REG-17431 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
   * Deprecated 10-Jan-2012; retained for existing callers - see REG-18601
   */
