class AccidentalDamageSettlementHandler {

  private static property get ReferThresholdAlbDir() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("AccidentalDamageSettlementHandler", 7500bd)
  }

  private static property get ReferThresholdAlbBrk() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("AccidentalDamageSettlementHandler", 12500bd)
  }

// NOTE: MIB rejects VRMs containing spaces; the same strip is also applied in albion.util.CommonPolicyUtils
  public static function evaluateAccidentalDamageSettlementHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (AGI-9193)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(exposure)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // PRB-35874 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, PRB-35874)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P153 behaviour verbatim (production behaviour, keep as is)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // brands without explicit routing are referred to underwriting
    }
    return result
  }

  /**
   * Deprecated 17-Oct-2012; retained for existing callers - see CHG-10694
   */
  @Deprecated
  public static function evaluateAccidentalDamageSettlementHandler_v1(exposure : KeyableBean) : boolean {
    // retained because the ALBDIR renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return exposure != null  // v1 contract: non-null check only, as in POLARIS
  }
}
