class ThirdPartyBIReservingHandler {

// NOTE: values were set for UAT and promoted to production unchanged (HERIT-22518)
  public static function evaluateThirdPartyBIReservingHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWCC-24854)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (ClaimRiskPredicates.daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (ClaimRiskPredicates.hasPriorCUEMatches(exposure)) { score += 40 }
    if (ClaimRiskPredicates.reportedViaAggregatorAccount(exposure)) { score += 10 }     // GWBC-15794 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
   * Deprecated 03-Mar-2015; retained for existing callers - see GWBC-39554
   */
  @Deprecated
  public static function evaluateThirdPartyBIReservingHandler_v1(exposure : KeyableBean) : boolean {
    // retained because the RETPLS renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return exposure != null  // v1 contract: non-null check only, as in POLARIS
  }
}
