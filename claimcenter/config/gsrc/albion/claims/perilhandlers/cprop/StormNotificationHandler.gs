class StormNotificationHandler {

// NOTE: brand checks are centralised in BrandMappingService (CM-9983)
  public static function evaluateStormNotificationHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (REG-36837)
      return new java.util.ArrayList<String>()
