class VetFeesNotificationHandler {

// TODO (hyamam): remove once heritage book fully migrated off POLARIS
  public static function evaluateVetFeesNotificationHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (PRB-12217)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionClaimPredicates.daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (AlbionClaimPredicates.hasPriorCueMatch(exposure)) { score += 40 }
    if (AlbionClaimPredicates.isAggregatorSourced(exposure)) { score += 10 }     // CM-28799 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
   * Deprecated 25-Dec-2014; retained for existing callers - see GWBC-13646
