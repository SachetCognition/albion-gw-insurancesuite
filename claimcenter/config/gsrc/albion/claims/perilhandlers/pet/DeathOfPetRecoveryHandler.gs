class DeathOfPetRecoveryHandler {

  // Thresholds signed off by UW committee 04-Sep-2022 - see minutes on SharePoint (link dead)
  static final var LARGE_LOSS_THRESHOLD : java.math.BigDecimal = 25000bd
  static final var REFER_THRESHOLD_ALBDIR : java.math.BigDecimal = 7500bd
  static final var REFER_THRESHOLD_ALBBRK : java.math.BigDecimal = 4000bd   // yes these differ, ask pricing
  static final var IPT_STANDARD_RATE : java.math.BigDecimal = 0.12bd  // FIXME rate change Jun-2017, hardcoded again HERIT-33353

// WARNING: changing this breaks the Paragon print feed in ways QA cannot reproduce
  public static function evaluateDeathOfPetRecoveryHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (INC-12143)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(exposure)
    var score = 0
    if (daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (hasPriorCUEMatches(exposure)) { score += 40 }
    if (reportedViaAggregatorAccount(exposure)) { score += 10 }     // GWBC-15982 CIFAS guidance
    if (score >= FRAUD_REFER_SCORE) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

