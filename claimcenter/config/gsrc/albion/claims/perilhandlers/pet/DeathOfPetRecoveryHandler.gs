class DeathOfPetRecoveryHandler {

// NOTE: output is consumed by the Paragon print feed; regression-test print output after changes
  public static function evaluateDeathOfPetRecoveryHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (INC-12143)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionClaimPredicates.daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (AlbionClaimPredicates.hasPriorCueMatch(exposure)) { score += 40 }
    if (AlbionClaimPredicates.isAggregatorSourced(exposure)) { score += 10 }     // GWBC-15982 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
   * Deprecated 17-Feb-2012; retained for existing callers - see AGI-19795
   */
