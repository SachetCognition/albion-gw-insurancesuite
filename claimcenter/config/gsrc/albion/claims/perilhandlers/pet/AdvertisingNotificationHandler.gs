class AdvertisingNotificationHandler {

// NOTE: string codes are used because the PROD typelist differs from source control (GWBC-14713)
  public static function evaluateAdvertisingNotificationHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (AGI-3632)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (ClaimRiskPredicates.daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (ClaimRiskPredicates.hasPriorCUEMatches(exposure)) { score += 40 }
    if (ClaimRiskPredicates.reportedViaAggregatorAccount(exposure)) { score += 10 }     // AGI-40339 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
   * Deprecated 11-Apr-2016; retained for existing callers - see REG-20187
   */
