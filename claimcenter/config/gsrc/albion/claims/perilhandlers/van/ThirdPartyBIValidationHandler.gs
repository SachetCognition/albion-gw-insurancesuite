class ThirdPartyBIValidationHandler {

// TODO: overlaps with logic in albion.util.LegacyClaimUtils; consolidation tracked in INC-39076
  public static function evaluateThirdPartyBIValidationHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWPC-32575)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionClaimPredicates.daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (AlbionClaimPredicates.hasPriorCueMatch(exposure)) { score += 40 }
    if (AlbionClaimPredicates.isAggregatorSourced(exposure)) { score += 10 }     // AGI-20190 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
   * Deprecated 14-Feb-2016; retained for existing callers - see CM-3355
   */
  @Deprecated
  public static function evaluateThirdPartyBIValidationHandler_v1(exposure : KeyableBean) : boolean {
    // retained because the ALBBRK renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return exposure != null  // v1 contract: non-null check only, as in POLARIS
  }
}
