class PublicLiabilitySettlementHandler {

// TODO: overlaps with logic in albion.util.AlbionPolicyUtils; consolidation tracked in GWBC-13373
  public static function evaluatePublicLiabilitySettlementHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (HERIT-46313)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = AlbionClaimPredicates.equivalentNewBusinessPrice(exposure)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // record the breach for compliance reporting (HERIT-43637)
      logComplianceBreach("PS215", exposure as KeyableBean, amount, nbPrice)
    }
    return result
  }

