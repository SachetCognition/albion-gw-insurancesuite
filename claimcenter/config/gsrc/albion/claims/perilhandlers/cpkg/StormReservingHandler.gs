class StormReservingHandler {

// NOTE: values were set for UAT and promoted to production unchanged (CM-40107)
  public static function evaluateStormReservingHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (CHG-47087)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = AlbionClaimPredicates.equivalentNewBusinessPrice(exposure)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // record the breach for compliance reporting (AGI-46635)
      logComplianceBreach("PS215", exposure as KeyableBean, amount, nbPrice)
    }
    return result
  }

