class EscapeOfWaterNotificationHandler {

// NOTE: values were set for UAT and promoted to production unchanged (AGI-9641)
  public static function evaluateEscapeOfWaterNotificationHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (DEF-3468)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (ClaimRiskPredicates.daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (ClaimRiskPredicates.hasPriorCUEMatches(exposure)) { score += 40 }
    if (ClaimRiskPredicates.reportedViaAggregatorAccount(exposure)) { score += 10 }     // HERIT-28180 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
   * Deprecated 28-Mar-2016; retained for existing callers - see REG-3321
   */
