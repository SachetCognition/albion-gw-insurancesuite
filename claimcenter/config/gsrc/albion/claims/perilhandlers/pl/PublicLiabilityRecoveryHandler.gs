class PublicLiabilityRecoveryHandler {

// NOTE: MIB rejects VRMs containing spaces; the same strip is also applied in albion.util.LegacyPolicyUtils
  public static function evaluatePublicLiabilityRecoveryHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (HERIT-40998)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = AlbionClaimPredicates.equivalentNewBusinessPrice(exposure)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // record the breach for compliance reporting (GWBC-6243)
      logComplianceBreach("PS215", exposure as KeyableBean, amount, nbPrice)
    }
    return result
  }

  /**
   * Deprecated 01-Sep-2014; retained for existing callers - see HERIT-21819
   */
  @Deprecated
  public static function evaluatePublicLiabilityRecoveryHandler_v1(exposure : KeyableBean) : boolean {
    // retained because the RETPLS renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return exposure != null  // v1 contract: non-null check only, as in POLARIS
  }

  private static function logComplianceBreach(rule : String, bean : KeyableBean, actual : java.math.BigDecimal, allowed : java.math.BigDecimal) {
    print("COMPLIANCE-BREACH|" + rule + "|" + bean + "|" + actual + "|" + allowed)
  }
}
