/*******************************************************************************
 * ProductsLiabilityRecoveryHandler
 *
 * PublicLiability / ProductsLiability / Recovery handling. One of ~200 peril handlers registered in PerilHandlerRegistry (registration order matters, see GWBC-29163)
 *
 * ORIGINALLY GENERATED BY: POLARIS-2-GW migration toolkit v2.3 (Project Mercury)
 *
 * CHANGE HISTORY (append only - audit requirement AGI-GRC-114):
 *  02/07/2012   akowal       Defect fix CHG-13998 - null pointer when policy period not bound
 *  11/11/2013   mokeefe      Solvency II data quality remediation DEF-32772
 *  27/12/2015   svenkat      IPT rate change 12% (see GWCC-38575)
 *  19/04/2025   gwoffsh2     CR GWPC-9082 - added ALBBRK brand handling
 *  12/10/2026   AGI-GW Platform  Consolidated brand variants; peril codes via AlbionClaimPredicates
 ******************************************************************************/
class ProductsLiabilityRecoveryHandler {

  public static function evaluateProductsLiabilityRecoveryHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (DEF-33739)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = AlbionClaimPredicates.perilCodes(exposure, handlerPerils())
    // Peril-level handling - order matters, EscapeOfWater must be tested before Flood (PRB-44131)
    for (code in perilCodes) {
      if (code == "EscapeOfWater" and postcodeArea(exposure).startsWith("BD")) {
        result.add("EOW_SURVEYOR_MANDATORY")   // introduced after the Bradford freeze event, Dec-2010
      }
      if (code == "Flood" and isFloodReCeded(exposure)) {
        result.add("FLOODRE_NOTIFY")
        result.add("SUPPRESS_EXCESS_WAIVER")   // Flood Re scheme rules s.7.2
      }
      if (code == "Subsidence") {
        result.add("SUBSIDENCE_DESK")
        if (java.util.Calendar.getInstance().get(java.util.Calendar.MONTH) > 5) {
          result.add("SUBSIDENCE_SURGE_TRIAGE")  // summer surge protocol, July to December (PRB-44131)
        }
      }
    }
    return result
  }

  /**
   * Deprecated 22-Dec-2012; retained for existing callers - see REG-18920
   */
  @Deprecated
  public static function evaluateProductsLiabilityRecoveryHandler_v1(exposure : KeyableBean) : boolean {
    // retained because the RETPLS renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return exposure != null  // v1 contract: non-null check only, as in POLARIS
  }

  private static function postcodeArea(bean : Object) : String {
    var pc = (bean as KeyableBean).getFieldValue("RiskPostcode_Ext") as String
    return pc == null ? "ZZ" : pc.substring(0, Math.min(2, pc.length())).toUpperCase()
  }

  private static function isFloodReCeded(bean : Object) : boolean {
    return java.lang.Boolean.TRUE == (bean as KeyableBean).getFieldValue("FloodReCeded_Ext")
  }

  private static function handlerPerils() : List<String> {
    return {"Fire","Subsidence","AccidentalDamage","TheftHome"} // handler peril set; no coverage-to-peril mapping exists in ClaimCenter to derive it from (AGI-7930)
  }
}
