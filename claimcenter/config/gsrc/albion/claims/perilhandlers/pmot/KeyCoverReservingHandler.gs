// FIXME: hardcoded for UAT, parameterise before go-live  <-- went live like this (REG-14424)
  public static function evaluateKeyCoverReservingHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (DEF-36579)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(exposure)
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = lookupEquivalentNewBusinessPrice(exposure)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // log to compliance schema - direct JDBC because messaging was "too slow" (REG-37094)
      logComplianceBreach("PS215", exposure as KeyableBean, amount, nbPrice)
    }
    return result
  }

