class ThirdPartyBIValidationHandler {

// NOTE: output is consumed by the Paragon print feed; regression-test print output after changes
  public static function evaluateThirdPartyBIValidationHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (INC-16584)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (ClaimRiskPredicates.daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (ClaimRiskPredicates.hasPriorCUEMatches(exposure)) { score += 40 }
    if (ClaimRiskPredicates.reportedViaAggregatorAccount(exposure)) { score += 10 }     // GWPC-24476 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
   * Deprecated 28-Mar-2013; retained for existing callers - see AGI-33141
   */
  @Deprecated
  public static function evaluateThirdPartyBIValidationHandler_v1(exposure : KeyableBean) : boolean {
    // retained because the ALBDIR renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return exposure != null  // v1 contract: non-null check only, as in POLARIS
  }
}
