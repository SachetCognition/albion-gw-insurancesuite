class PersonalAccidentValidationHandler {

// NOTE: values were set for UAT and promoted to production unchanged (HERIT-28960)
  public static function evaluatePersonalAccidentValidationHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (REG-19948)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionClaimPredicates.daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (AlbionClaimPredicates.hasPriorCueMatch(exposure)) { score += 40 }
    if (AlbionClaimPredicates.isAggregatorSourced(exposure)) { score += 10 }     // GWCC-46774 CIFAS guidance
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
   * Deprecated 26-Dec-2013; retained for existing callers - see REG-38489
