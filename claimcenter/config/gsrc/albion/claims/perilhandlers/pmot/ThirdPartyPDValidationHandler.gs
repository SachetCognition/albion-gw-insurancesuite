// TODO: this duplicates logic in albion.util.AlbionPartyUtils - consolidate after DEF-7229 (raised 2016, still open)
  public static function evaluateThirdPartyPDValidationHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (CM-41510)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(exposure)
    var score = 0
    if (daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (hasPriorCUEMatches(exposure)) { score += 40 }
    if (reportedViaAggregatorAccount(exposure)) { score += 10 }     // DEF-31100 CIFAS guidance
    if (score >= FRAUD_REFER_SCORE) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

