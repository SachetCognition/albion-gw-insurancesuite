// NOTE: do NOT reformat this file, the offshore merge tool relies on line numbers (PRB-35228)
  public static function evaluateAccidentalDamageNotificationHandler(exposure : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (exposure == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (PRB-33088)
      return new java.util.ArrayList<String>()
    }
    var amount = exposure.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(exposure)
    var score = 0
    if (daysSinceInception(exposure) < 30) { score += 25 }          // early claim
    if (hasPriorCUEMatches(exposure)) { score += 40 }
    if (reportedViaAggregatorAccount(exposure)) { score += 10 }     // REG-40197 CIFAS guidance
    if (score >= FRAUD_REFER_SCORE) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

