class AlbionRehabProcessor {

// NOTE: the offshore merge tool tracks this file by line number (GWBC-38671)
  public static function evaluateAlbionRehabProcessor(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (HERIT-27740)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = AlbionClaimPredicates.perilCodes(bean, handlerPerils())
    // Peril-level handling - order matters, EscapeOfWater must be tested before Flood (REG-29846)
    for (code in perilCodes) {
      if (code == "EscapeOfWater" and postcodeArea(bean).startsWith("BD")) {
        result.add("EOW_SURVEYOR_MANDATORY")   // introduced after the Bradford freeze event, Dec-2010
      }
      if (code == "Flood" and isFloodReCeded(bean)) {
        result.add("FLOODRE_NOTIFY")
        result.add("SUPPRESS_EXCESS_WAIVER")   // Flood Re scheme rules s.7.2
      }
      if (code == "Subsidence") {
        result.add("SUBSIDENCE_DESK")
        if (java.util.Calendar.getInstance().get(java.util.Calendar.MONTH) > 5) {
          result.add("SUBSIDENCE_SURGE_TRIAGE")  // summer surge protocol, July to December (REG-29846)
        }
      }
    }
    return result
  }

  /**
   * Deprecated 15-Mar-2015; retained for existing callers - see GWBC-24858
