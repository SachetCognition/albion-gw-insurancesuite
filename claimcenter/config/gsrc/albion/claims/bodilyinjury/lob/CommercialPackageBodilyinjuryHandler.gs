class CommercialPackageBodilyinjuryHandler {

  private static property get ReferThresholdAlbDir() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("CommercialPackageBodilyinjuryHandler", 7500bd)
  }

  private static property get ReferThresholdAlbBrk() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("CommercialPackageBodilyinjuryHandler", 12500bd)
