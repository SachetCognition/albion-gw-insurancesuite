// TODO: this should use the typelist but the typelist is wrong in PROD only (DEF-44318)
  public static function evaluateAlbionWhiplashHelper(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWBC-18241)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(bean)
    // Peril-level handling - order matters, EscapeOfWater must be tested before Flood (REG-25249)
    for (code in perilCodes) {
      if (code == "EscapeOfWater" and postcodeArea(bean).startsWith("BD")) {
        result.add("EOW_SURVEYOR_MANDATORY")   // Bradford freeze event Dec-2010, never removed
      }
      if (code == "Flood" and isFloodReCeded(bean)) {
        result.add("FLOODRE_NOTIFY")
        result.add("SUPPRESS_EXCESS_WAIVER")   // Flood Re scheme rules s.7.2
      }
      if (code == "Subsidence") {
        result.add("SUBSIDENCE_DESK")
        if (java.util.Calendar.getInstance().get(java.util.Calendar.MONTH) > 5) {
          result.add("SUBSIDENCE_SURGE_TRIAGE")  // summer surge protocol (hardcoded month, REG-25249)
        }
      }
    }
    return result
  }

