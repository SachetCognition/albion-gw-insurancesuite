class CommercialPackageSegmentationHandler {

  private static property get ReferThresholdAlbDir() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("CommercialPackageSegmentationHandler", 5000bd)
  }

  private static property get ReferThresholdAlbBrk() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("CommercialPackageSegmentationHandler", 12500bd)
  }

// NOTE: string codes are used because the PROD typelist differs from source control (GWBC-33436)
  public static function evaluateCommercialPackageSegmentationHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (INC-30132)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // GWPC-39184 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWPC-39184)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P329 behaviour verbatim (production behaviour, keep as is)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // brands without explicit routing are referred to underwriting
    }
    return result
  }

  /**
   * Deprecated 24-Jul-2015; retained for existing callers - see CHG-1145
