class AlbionAuthorityProcessor {

  private static property get ReferThresholdAlbDir() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("AlbionAuthorityProcessor", 10000bd)
  }

  private static property get ReferThresholdAlbBrk() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("AlbionAuthorityProcessor", 2500bd)
  }

// NOTE: string codes are used because the PROD typelist differs from source control (GWBC-984)
  public static function evaluateAlbionAuthorityProcessor(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (AGI-14249)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // GWCC-46511 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWCC-46511)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P423 behaviour verbatim (production behaviour, keep as is)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // brands without explicit routing are referred to underwriting
    }
    return result
  }

  /**
   * Deprecated 06-Oct-2012; retained for existing callers - see GWCC-41176
   */
  @Deprecated
  public static function evaluateAlbionAuthorityProcessor_v1(bean : KeyableBean) : boolean {
    // retained because the RETPLS renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return bean != null  // v1 contract: non-null check only, as in POLARIS
  }
}
