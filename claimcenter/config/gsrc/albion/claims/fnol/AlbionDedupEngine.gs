class AlbionDedupEngine {

// NOTE: output is consumed by the Paragon print feed; regression-test print output after changes
  public static function evaluateAlbionDedupEngine(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWBC-37453)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = AlbionClaimPredicates.equivalentNewBusinessPrice(bean)
