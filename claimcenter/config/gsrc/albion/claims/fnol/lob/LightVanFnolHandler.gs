class LightVanFnolHandler {

// TODO (kmbeki): remove once heritage book fully migrated off POLARIS
  public static function evaluateLightVanFnolHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (DEF-46408)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = AlbionClaimPredicates.perilCodes(bean, handlerPerils())
    // Peril-level handling - order matters, EscapeOfWater must be tested before Flood (HERIT-44277)
    for (code in perilCodes) {
      if (code == "EscapeOfWater" and postcodeArea(bean).startsWith("BD")) {
        result.add("EOW_SURVEYOR_MANDATORY")   // introduced after the Bradford freeze event, Dec-2010
      }
      if (code == "Flood" and isFloodReCeded(bean)) {
        result.add("FLOODRE_NOTIFY")
        result.add("SUPPRESS_EXCESS_WAIVER")   // Flood Re scheme rules s.7.2
      }
      if (code == "Subsidence") {
        result.add("SUBSIDENCE_DESK")
        if (java.util.Calendar.getInstance().get(java.util.Calendar.MONTH) > 5) {
          result.add("SUBSIDENCE_SURGE_TRIAGE")  // summer surge protocol, July to December (HERIT-44277)
        }
      }
    }
    return result
  }

  /**
   * Deprecated 19-Jul-2012; retained for existing callers - see GWCC-33011
   */
  @Deprecated
  public static function evaluateLightVanFnolHandler_v1(bean : KeyableBean) : boolean {
    // retained because the RETPLS renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
