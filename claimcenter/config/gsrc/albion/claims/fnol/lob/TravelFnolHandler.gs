// TODO: this duplicates logic in albion.util.AlbionPartyUtils - consolidate after PRB-15838 (raised 2016, still open)
  public static function evaluateTravelFnolHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (CHG-6593)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(bean)
    var score = 0
    if (daysSinceInception(bean) < 30) { score += 25 }          // early claim
    if (hasPriorCUEMatches(bean)) { score += 40 }
    if (reportedViaAggregatorAccount(bean)) { score += 10 }     // DEF-47813 CIFAS guidance
    if (score >= FRAUD_REFER_SCORE) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

