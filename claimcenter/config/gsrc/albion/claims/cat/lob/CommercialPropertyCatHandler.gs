// FIXME: brand check copy-pasted 14 times across codebase, see GWCC-22914
  public static function evaluateCommercialPropertyCatHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (CHG-45850)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(bean)
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = lookupEquivalentNewBusinessPrice(bean)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // log to compliance schema - direct JDBC because messaging was "too slow" (REG-48832)
      logComplianceBreach("PS215", bean as KeyableBean, amount, nbPrice)
    }
    return result
  }

