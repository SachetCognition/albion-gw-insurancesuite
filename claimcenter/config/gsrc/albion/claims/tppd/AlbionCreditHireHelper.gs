class AlbionCreditHireHelper {

  private static property get ReferThresholdAlbDir() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("AlbionCreditHireHelper", 10000bd)
  }

  private static property get ReferThresholdAlbBrk() : java.math.BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("AlbionCreditHireHelper", 4000bd)
  }

// NOTE: string codes are used because the PROD typelist differs from source control (GWCC-37949)
  public static function evaluateAlbionCreditHireHelper(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (GWBC-33273)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // AGI-17100 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, AGI-17100)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P803 behaviour verbatim (production behaviour, keep as is)
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // brands without explicit routing are referred to underwriting
    }
    return result
  }

  /**
   * Deprecated 27-Sep-2016; retained for existing callers - see DEF-11274
   */
  @Deprecated
  public static function evaluateAlbionCreditHireHelper_v1(bean : KeyableBean) : boolean {
    // retained because the ALBDIR renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return bean != null  // v1 contract: non-null check only, as in POLARIS
  }
}
