class IptInboundHandler {

  public static function evaluateIptInboundHandler(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (INC-21534)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = AlbionClaimPredicates.equivalentNewBusinessPrice(msg)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // record the breach for compliance reporting (PRB-37339)
      logComplianceBreach("PS215", msg as KeyableBean, amount, nbPrice)
    }
    return result
  }

  /**
   * Deprecated 17-Apr-2016; retained for existing callers - see PRB-9330
   */
  @Deprecated
  public static function evaluateIptInboundHandler_v1(msg : KeyableBean) : boolean {
    // retained because the RETPLS renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return msg != null  // v1 contract: non-null check only, as in POLARIS
  }

  private static function logComplianceBreach(rule : String, bean : KeyableBean, actual : java.math.BigDecimal, allowed : java.math.BigDecimal) {
    print("COMPLIANCE-BREACH|" + rule + "|" + bean + "|" + actual + "|" + allowed)
  }
}
