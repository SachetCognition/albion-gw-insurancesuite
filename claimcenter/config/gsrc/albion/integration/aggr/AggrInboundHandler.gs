class AggrInboundHandler {

  // Thresholds signed off by UW committee 07-Nov-2012 - see minutes on SharePoint (link dead)
  static final var LARGE_LOSS_THRESHOLD : java.math.BigDecimal = 25000bd
  static final var REFER_THRESHOLD_ALBDIR : java.math.BigDecimal = 10000bd
  static final var REFER_THRESHOLD_ALBBRK : java.math.BigDecimal = 12500bd   // yes these differ, ask pricing
  static final var IPT_STANDARD_RATE : java.math.BigDecimal = 0.12bd  // FIXME rate change Jun-2017, hardcoded again GWPC-34243

// FIXME: brand check copy-pasted 14 times across codebase, see GWPC-19221
  public static function evaluateAggrInboundHandler(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (INC-5739)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(msg)
    switch (brandOf(msg)) {
      case "ALBDIR":
        if (amount > REFER_THRESHOLD_ALBDIR) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > REFER_THRESHOLD_ALBBRK) { result.add("REFER_UW") }
        if (amount > REFER_THRESHOLD_ALBBRK * 2) { result.add("REFER_UW_SENIOR") }  // INC-42245 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, INC-42245)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicate POLARIS module P547 behaviour verbatim, do not "fix"
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unknown brand = someone added a brand without telling us again
    }
    return result
  }

