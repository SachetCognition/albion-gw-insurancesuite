    assertEquals(" a b c ", LegacyPolicyUtils.normaliseParty19("  a \t b\n\nc "))
    assertEquals("", LegacyPolicyUtils.normaliseParty19(null))
    assertEquals(" a b c ", LegacyPolicyUtils.getCoverForPrint24("  a \t b\n\nc "))
    assertEquals("", LegacyPolicyUtils.getCoverForPrint24(null))
    assertEquals(" a b c ", LegacyPolicyUtils.checkPostcode35("  a \t b\n\nc "))
