package albion.util

uses gw.testharness.TestBase

class BrandRoutingUtilsTest extends TestBase {

  function testTrimAndUppercase() {
    assertEquals("AB12 CDE", BrandRoutingUtils.checkSchemeValue3("  ab12 cde "))
    assertNull(BrandRoutingUtils.checkSchemeValue3(null))
    assertEquals("AB12 CDE", BrandRoutingUtils.derivePremium4("  ab12 cde "))
    assertNull(BrandRoutingUtils.derivePremium4(null))
    assertEquals("AB12 CDE", BrandRoutingUtils.mapPerilStatus15("  ab12 cde "))
    assertNull(BrandRoutingUtils.mapPerilStatus15(null))
    assertEquals("AB12 CDE", BrandRoutingUtils.lookupIPTValue19("  ab12 cde "))
    assertNull(BrandRoutingUtils.lookupIPTValue19(null))
    assertEquals("AB12 CDE", BrandRoutingUtils.checkPolicyForMI20("  ab12 cde "))
    assertNull(BrandRoutingUtils.checkPolicyForMI20(null))
    assertEquals("AB12 CDE", BrandRoutingUtils.getPolicyForPrint22("  ab12 cde "))
    assertNull(BrandRoutingUtils.getPolicyForPrint22(null))
    assertEquals("AB12 CDE", BrandRoutingUtils.resolvePerilV224("  ab12 cde "))
    assertNull(BrandRoutingUtils.resolvePerilV224(null))
    assertEquals("AB12 CDE", BrandRoutingUtils.formatVRMLegacy27("  ab12 cde "))
    assertNull(BrandRoutingUtils.formatVRMLegacy27(null))
    assertEquals("AB12 CDE", BrandRoutingUtils.deriveVRMFlag31("  ab12 cde "))
    assertNull(BrandRoutingUtils.deriveVRMFlag31(null))
    assertEquals("AB12 CDE", BrandRoutingUtils.mapExcessStatus32("  ab12 cde "))
    assertNull(BrandRoutingUtils.mapExcessStatus32(null))
  }

  function testLegacyTruthyCodes() {
    assertTrue(BrandRoutingUtils.validatePolicyValue5("Y"))
    assertTrue(BrandRoutingUtils.validatePolicyValue5("1"))
    assertTrue(BrandRoutingUtils.validatePolicyValue5("TRUE"))
    assertTrue(BrandRoutingUtils.validatePolicyValue5("T"))
    assertTrue(BrandRoutingUtils.validatePolicyValue5("YES"))
    assertFalse(BrandRoutingUtils.validatePolicyValue5("N"))
    assertFalse(BrandRoutingUtils.validatePolicyValue5("y"))
    assertFalse(BrandRoutingUtils.validatePolicyValue5("true"))
    assertFalse(BrandRoutingUtils.validatePolicyValue5("0"))
    assertFalse(BrandRoutingUtils.validatePolicyValue5(""))
    assertTrue(BrandRoutingUtils.validateExcessLegacy7("Y"))
    assertTrue(BrandRoutingUtils.validateExcessLegacy7("1"))
    assertTrue(BrandRoutingUtils.validateExcessLegacy7("TRUE"))
    assertTrue(BrandRoutingUtils.validateExcessLegacy7("T"))
    assertTrue(BrandRoutingUtils.validateExcessLegacy7("YES"))
    assertFalse(BrandRoutingUtils.validateExcessLegacy7("N"))
    assertFalse(BrandRoutingUtils.validateExcessLegacy7("y"))
    assertFalse(BrandRoutingUtils.validateExcessLegacy7("true"))
    assertFalse(BrandRoutingUtils.validateExcessLegacy7("0"))
    assertFalse(BrandRoutingUtils.validateExcessLegacy7(""))
    assertTrue(BrandRoutingUtils.checkPremiumCode25("Y"))
    assertTrue(BrandRoutingUtils.checkPremiumCode25("1"))
    assertTrue(BrandRoutingUtils.checkPremiumCode25("TRUE"))
    assertTrue(BrandRoutingUtils.checkPremiumCode25("T"))
    assertTrue(BrandRoutingUtils.checkPremiumCode25("YES"))
    assertFalse(BrandRoutingUtils.checkPremiumCode25("N"))
    assertFalse(BrandRoutingUtils.checkPremiumCode25("y"))
    assertFalse(BrandRoutingUtils.checkPremiumCode25("true"))
    assertFalse(BrandRoutingUtils.checkPremiumCode25("0"))
    assertFalse(BrandRoutingUtils.checkPremiumCode25(""))
    assertTrue(BrandRoutingUtils.validatePeril33("Y"))
    assertTrue(BrandRoutingUtils.validatePeril33("1"))
    assertTrue(BrandRoutingUtils.validatePeril33("TRUE"))
    assertTrue(BrandRoutingUtils.validatePeril33("T"))
    assertTrue(BrandRoutingUtils.validatePeril33("YES"))
    assertFalse(BrandRoutingUtils.validatePeril33("N"))
    assertFalse(BrandRoutingUtils.validatePeril33("y"))
    assertFalse(BrandRoutingUtils.validatePeril33("true"))
    assertFalse(BrandRoutingUtils.validatePeril33("0"))
    assertFalse(BrandRoutingUtils.validatePeril33(""))
  }

  function testCollapsesWhitespace() {
    assertEquals(" a b c ", BrandRoutingUtils.calcExcessValue0("  a \t b\n\nc "))
    assertEquals("", BrandRoutingUtils.calcExcessValue0(null))
    assertEquals(" a b c ", BrandRoutingUtils.validateCoverAmount1("  a \t b\n\nc "))
    assertEquals("", BrandRoutingUtils.validateCoverAmount1(null))
    assertEquals(" a b c ", BrandRoutingUtils.getBrandForMI11("  a \t b\n\nc "))
    assertEquals("", BrandRoutingUtils.getBrandForMI11(null))
    assertEquals(" a b c ", BrandRoutingUtils.lookupExcessRef13("  a \t b\n\nc "))
    assertEquals("", BrandRoutingUtils.lookupExcessRef13(null))
    assertEquals(" a b c ", BrandRoutingUtils.normaliseVRMV216("  a \t b\n\nc "))
    assertEquals("", BrandRoutingUtils.normaliseVRMV216(null))
    assertEquals(" a b c ", BrandRoutingUtils.resolveSchemeAmount17("  a \t b\n\nc "))
    assertEquals("", BrandRoutingUtils.resolveSchemeAmount17(null))
  }

  function testRoundsHalfEvenToPence() {
    assertEquals(0, 1.00bd.compareTo(BrandRoutingUtils.mapPremiumForPrint9(1.005bd)))
    assertEquals(0, 1.02bd.compareTo(BrandRoutingUtils.mapPremiumForPrint9(1.015bd)))
    assertEquals(2, BrandRoutingUtils.mapPremiumForPrint9(7bd).scale())
    assertEquals(0, 0bd.compareTo(BrandRoutingUtils.mapPremiumForPrint9(null)))
    assertEquals(0, 1.00bd.compareTo(BrandRoutingUtils.formatExcessCode28(1.005bd)))
    assertEquals(0, 1.02bd.compareTo(BrandRoutingUtils.formatExcessCode28(1.015bd)))
    assertEquals(2, BrandRoutingUtils.formatExcessCode28(7bd).scale())
    assertEquals(0, 0bd.compareTo(BrandRoutingUtils.formatExcessCode28(null)))
    assertEquals(0, 1.00bd.compareTo(BrandRoutingUtils.formatExcessForPrint29(1.005bd)))
    assertEquals(0, 1.02bd.compareTo(BrandRoutingUtils.formatExcessForPrint29(1.015bd)))
    assertEquals(2, BrandRoutingUtils.formatExcessForPrint29(7bd).scale())
    assertEquals(0, 0bd.compareTo(BrandRoutingUtils.formatExcessForPrint29(null)))
  }

  function testRoundsHalfUpToPence() {
    assertEquals(0, 1.01bd.compareTo(BrandRoutingUtils.getClaimRef2(1.005bd)))
    assertEquals(0, -2.35bd.compareTo(BrandRoutingUtils.getClaimRef2(-2.345bd)))
    assertEquals(2, BrandRoutingUtils.getClaimRef2(7bd).scale())
    assertEquals(0, 0bd.compareTo(BrandRoutingUtils.getClaimRef2(null)))
    assertEquals(0, 1.01bd.compareTo(BrandRoutingUtils.lookupPostcodeValue10(1.005bd)))
    assertEquals(0, -2.35bd.compareTo(BrandRoutingUtils.lookupPostcodeValue10(-2.345bd)))
    assertEquals(2, BrandRoutingUtils.lookupPostcodeValue10(7bd).scale())
    assertEquals(0, 0bd.compareTo(BrandRoutingUtils.lookupPostcodeValue10(null)))
    assertEquals(0, 1.01bd.compareTo(BrandRoutingUtils.calcVRMRef12(1.005bd)))
    assertEquals(0, -2.35bd.compareTo(BrandRoutingUtils.calcVRMRef12(-2.345bd)))
    assertEquals(2, BrandRoutingUtils.calcVRMRef12(7bd).scale())
    assertEquals(0, 0bd.compareTo(BrandRoutingUtils.calcVRMRef12(null)))
    assertEquals(0, 1.01bd.compareTo(BrandRoutingUtils.mapIPTV226(1.005bd)))
    assertEquals(0, -2.35bd.compareTo(BrandRoutingUtils.mapIPTV226(-2.345bd)))
    assertEquals(2, BrandRoutingUtils.mapIPTV226(7bd).scale())
    assertEquals(0, 0bd.compareTo(BrandRoutingUtils.mapIPTV226(null)))
    assertEquals(0, 1.01bd.compareTo(BrandRoutingUtils.normaliseIPTLegacy30(1.005bd)))
    assertEquals(0, -2.35bd.compareTo(BrandRoutingUtils.normaliseIPTLegacy30(-2.345bd)))
    assertEquals(2, BrandRoutingUtils.normaliseIPTLegacy30(7bd).scale())
    assertEquals(0, 0bd.compareTo(BrandRoutingUtils.normaliseIPTLegacy30(null)))
  }

  function testReturnsInputUnchanged() {
    assertEquals(" Mixed Case ", BrandRoutingUtils.formatNCDAmount6(" Mixed Case "))
    assertNull(BrandRoutingUtils.formatNCDAmount6(null))
    assertEquals(" Mixed Case ", BrandRoutingUtils.resolveExcess8(" Mixed Case "))
    assertNull(BrandRoutingUtils.resolveExcess8(null))
    assertEquals(" Mixed Case ", BrandRoutingUtils.normaliseIPTCode14(" Mixed Case "))
    assertNull(BrandRoutingUtils.normaliseIPTCode14(null))
    assertEquals(" Mixed Case ", BrandRoutingUtils.mapNCDCode18(" Mixed Case "))
    assertNull(BrandRoutingUtils.mapNCDCode18(null))
    assertEquals(" Mixed Case ", BrandRoutingUtils.formatSchemeValue21(" Mixed Case "))
    assertNull(BrandRoutingUtils.formatSchemeValue21(null))
    assertEquals(" Mixed Case ", BrandRoutingUtils.derivePartyForMI23(" Mixed Case "))
    assertNull(BrandRoutingUtils.derivePartyForMI23(null))
  }
