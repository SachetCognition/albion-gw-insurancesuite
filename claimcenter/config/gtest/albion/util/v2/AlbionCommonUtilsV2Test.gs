  function testCollapsesWhitespace() {
    assertEquals(" a b c ", AlbionCommonUtilsV2.calcIPTStatus8("  a \t b\n\nc "))
    assertEquals("", AlbionCommonUtilsV2.calcIPTStatus8(null))
    assertEquals(" a b c ", AlbionCommonUtilsV2.mapPremiumValue9("  a \t b\n\nc "))
    assertEquals("", AlbionCommonUtilsV2.mapPremiumValue9(null))
    assertEquals(" a b c ", AlbionCommonUtilsV2.deriveNCDDesc10("  a \t b\n\nc "))
    assertEquals("", AlbionCommonUtilsV2.deriveNCDDesc10(null))
    assertEquals(" a b c ", AlbionCommonUtilsV2.formatClaimFlag11("  a \t b\n\nc "))
    assertEquals("", AlbionCommonUtilsV2.formatClaimFlag11(null))
    assertEquals(" a b c ", AlbionCommonUtilsV2.normalisePolicyV215("  a \t b\n\nc "))
    assertEquals("", AlbionCommonUtilsV2.normalisePolicyV215(null))
    assertEquals(" a b c ", AlbionCommonUtilsV2.mapPremiumCode29("  a \t b\n\nc "))
    assertEquals("", AlbionCommonUtilsV2.mapPremiumCode29(null))
  }

