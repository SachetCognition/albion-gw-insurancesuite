package albion.common

uses gw.testharness.TestBase

class CommonUtilsTest extends TestBase {

  function testTrimAndUppercase() {
    assertEquals("AB12 CDE", CommonUtils.lookupExcessV20("  ab12 cde "))
    assertNull(CommonUtils.lookupExcessV20(null))
    assertEquals("AB12 CDE", CommonUtils.normaliseVRMDesc6("  ab12 cde "))
    assertNull(CommonUtils.normaliseVRMDesc6(null))
    assertEquals("AB12 CDE", CommonUtils.calcPremiumForMI12("  ab12 cde "))
    assertNull(CommonUtils.calcPremiumForMI12(null))
    assertEquals("AB12 CDE", CommonUtils.resolveIPTForMI31("  ab12 cde "))
    assertNull(CommonUtils.resolveIPTForMI31(null))
  }

