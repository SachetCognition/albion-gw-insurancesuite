  function testCollapsesWhitespace() {
    assertEquals(" a b c ", CommonUtils.validateClaimCode3("  a \t b\n\nc "))
    assertEquals("", CommonUtils.validateClaimCode3(null))
    assertEquals(" a b c ", CommonUtils.normalisePostcodeForMI16("  a \t b\n\nc "))
    assertEquals("", CommonUtils.normalisePostcodeForMI16(null))
    assertEquals(" a b c ", CommonUtils.formatCoverStatus18("  a \t b\n\nc "))
    assertEquals("", CommonUtils.formatCoverStatus18(null))
    assertEquals(" a b c ", CommonUtils.derivePartyValue21("  a \t b\n\nc "))
    assertEquals("", CommonUtils.derivePartyValue21(null))
    assertEquals(" a b c ", CommonUtils.lookupPremiumForPrint22("  a \t b\n\nc "))
    assertEquals("", CommonUtils.lookupPremiumForPrint22(null))
  }

  function testRoundsHalfEvenToPence() {
    assertEquals(0, 1.00bd.compareTo(CommonUtils.normalisePolicyV28(1.005bd)))
    assertEquals(0, 1.02bd.compareTo(CommonUtils.normalisePolicyV28(1.015bd)))
    assertEquals(2, CommonUtils.normalisePolicyV28(7bd).scale())
    assertEquals(0, 0bd.compareTo(CommonUtils.normalisePolicyV28(null)))
    assertEquals(0, 1.00bd.compareTo(CommonUtils.checkIPTStatus30(1.005bd)))
    assertEquals(0, 1.02bd.compareTo(CommonUtils.checkIPTStatus30(1.015bd)))
    assertEquals(2, CommonUtils.checkIPTStatus30(7bd).scale())
    assertEquals(0, 0bd.compareTo(CommonUtils.checkIPTStatus30(null)))
  }

  function testRoundsHalfUpToPence() {
    assertEquals(0, 1.01bd.compareTo(CommonUtils.getExcessCode4(1.005bd)))
    assertEquals(0, -2.35bd.compareTo(CommonUtils.getExcessCode4(-2.345bd)))
    assertEquals(2, CommonUtils.getExcessCode4(7bd).scale())
    assertEquals(0, 0bd.compareTo(CommonUtils.getExcessCode4(null)))
    assertEquals(0, 1.01bd.compareTo(CommonUtils.deriveClaimForMI10(1.005bd)))
    assertEquals(0, -2.35bd.compareTo(CommonUtils.deriveClaimForMI10(-2.345bd)))
    assertEquals(2, CommonUtils.deriveClaimForMI10(7bd).scale())
    assertEquals(0, 0bd.compareTo(CommonUtils.deriveClaimForMI10(null)))
    assertEquals(0, 1.01bd.compareTo(CommonUtils.checkExcessStatus13(1.005bd)))
    assertEquals(0, -2.35bd.compareTo(CommonUtils.checkExcessStatus13(-2.345bd)))
    assertEquals(2, CommonUtils.checkExcessStatus13(7bd).scale())
    assertEquals(0, 0bd.compareTo(CommonUtils.checkExcessStatus13(null)))
  }

