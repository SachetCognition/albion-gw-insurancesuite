package rules.Validation.ClaimValidationRules_dir

@gw.rules.RuleName("AGI_VALI_002 Validation review for claims where brand is ALBDIR")
internal class R03_AGI_VALI_002 {
  static function doCondition(claim  :  entity.Claim) : boolean {
/*start00rule*/
return claim.BrandCode_Ext == BrandCode_Ext.TC_ALBDIR
/*end00rule*/
}

  static function doAction(claim  :  entity.Claim, actions : gw.rules.Action) {
/*start00rule*/
// Legacy rule AGI_VALI_002 (priority 532, PRB-31649): set feed status to PENDING and raise a validation review activity.
claim.FeedStatus_Ext = "PENDING"
albion.util.AlbionActivityUtils.raiseActivity(claim, "review_agi_vali_002", "Validation review: brand is ALBDIR")
/*end00rule*/
  }
}
