package rules.Escalation

@gw.rules.RuleName("ClaimEscalationRules")
@gw.rules.RuleSetDescription("Raises escalation activities")
@gw.lang.Export
class ClaimEscalationRules extends gw.rules.RuleSetBase {
  static function invoke(bean : entity.Claim) : gw.rules.ExecutionSession {
    return invoke( new gw.rules.ExecutionSession(), bean )
  }

  static function invoke(exeSession : gw.rules.ExecutionSession, bean : entity.Claim) : gw.rules.ExecutionSession {
    return _invoke( exeSession, bean, "ClaimEscalationRules", ClaimEscalationRules)
  }
}
