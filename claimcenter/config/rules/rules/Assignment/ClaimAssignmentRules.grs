package rules.Assignment

@gw.rules.RuleName("ClaimAssignmentRules")
@gw.rules.RuleSetDescription("Raises assignment review activities")
@gw.lang.Export
class ClaimAssignmentRules extends gw.rules.RuleSetBase {
  static function invoke(bean : entity.Claim) : gw.rules.ExecutionSession {
    return invoke( new gw.rules.ExecutionSession(), bean )
  }

  static function invoke(exeSession : gw.rules.ExecutionSession, bean : entity.Claim) : gw.rules.ExecutionSession {
    return _invoke( exeSession, bean, "ClaimAssignmentRules", ClaimAssignmentRules)
  }
}
