package rules.Preupdate.ClaimPreupdateRules_dir

@gw.rules.RuleName("AGI_PREU_001 Pre-update review for claims where brand is ALBBRK")
internal class R01_AGI_PREU_001 {
  static function doCondition(claim  :  entity.Claim) : boolean {
/*start00rule*/
return claim.BrandCode_Ext == BrandCode_Ext.TC_ALBBRK
/*end00rule*/
}

  static function doAction(claim  :  entity.Claim, actions : gw.rules.Action) {
/*start00rule*/
// Legacy rule AGI_PREU_001 (priority 233, CM-813): set feed status to PENDING and raise a pre-update review activity.
claim.FeedStatus_Ext = "PENDING"
albion.util.AlbionActivityUtils.raiseActivity(claim, "review_agi_preu_001", "Pre-update review: brand is ALBBRK")
/*end00rule*/
  }
}
