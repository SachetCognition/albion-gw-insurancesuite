package rules.Preupdate

@gw.rules.RuleName("ClaimPreupdateRules")
@gw.rules.RuleSetDescription("Resets the outbound feed state and raises review activities on claim update")
@gw.lang.Export
class ClaimPreupdateRules extends gw.rules.RuleSetBase {
  static function invoke(bean : entity.Claim) : gw.rules.ExecutionSession {
    return invoke( new gw.rules.ExecutionSession(), bean )
  }

  static function invoke(exeSession : gw.rules.ExecutionSession, bean : entity.Claim) : gw.rules.ExecutionSession {
    return _invoke( exeSession, bean, "ClaimPreupdateRules", ClaimPreupdateRules)
  }
}
