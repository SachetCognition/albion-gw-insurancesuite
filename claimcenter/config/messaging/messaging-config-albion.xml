<?xml version="1.0"?>
<!-- Albion outbound destinations. Each transport plugin spools the message to the feed's outbound directory (see FlatFileSpooler). -->
<messaging-config
  xmlns="http://guidewire.com/messaging-config"
  defaultServer="#messaging">
  <messaging>
    <!-- Motor Insurance Database (MIB) vehicle feed -->
    <destination
      id="60"
      name="Motor Insurance Database (MIB) vehicle feed"
      transportplugin="MidTransport"
      sendorder="AnyOrder"
      pollinterval="60000"
      retryinterval="300000"/>
    <!-- Claims & Underwriting Exchange enquiry/load -->
    <destination
      id="61"
      name="Claims &amp; Underwriting Exchange enquiry/load"
      transportplugin="CueTransport"
      sendorder="AnyOrder"
      pollinterval="30000"
      retryinterval="60000"/>
    <!-- Employers Liability Tracing Office ELD feed -->
    <destination
      id="62"
      name="Employers Liability Tracing Office ELD feed"
      transportplugin="EltoTransport"
      sendorder="InOrder"
      pollinterval="30000"
      retryinterval="300000"/>
    <!-- Flood Re cession & bordereaux -->
    <destination
      id="63"
      name="Flood Re cession &amp; bordereaux"
      transportplugin="FloodreTransport"
      sendorder="InOrder"
      pollinterval="30000"
      retryinterval="60000"/>
    <!-- HMT/OFSI sanctions & PEP screening via WorldCheck -->
    <destination
      id="64"
      name="HMT/OFSI sanctions &amp; PEP screening via WorldCheck"
      transportplugin="SanctionsTransport"
      sendorder="AnyOrder"
      pollinterval="5000"
      retryinterval="60000"/>
    <!-- DVLA MyLicence ADD/DDS lookup -->
    <destination
      id="65"
      name="DVLA MyLicence ADD/DDS lookup"
      transportplugin="DvlaTransport"
      sendorder="InOrder"
      pollinterval="5000"
      retryinterval="300000"/>
    <!-- CIFAS fraud database -->
    <destination
      id="66"
      name="CIFAS fraud database"
      transportplugin="CifasTransport"
      sendorder="AnyOrder"
      pollinterval="30000"
      retryinterval="60000"/>
    <!-- Insurance Premium Tax calculation & HMRC returns -->
    <destination
      id="67"
      name="Insurance Premium Tax calculation &amp; HMRC returns"
      transportplugin="IptTransport"
      sendorder="AnyOrder"
      pollinterval="60000"
      retryinterval="60000"/>
    <!-- POLARIS mainframe policy admin (heritage book) nightly sync -->
    <destination
      id="68"
      name="POLARIS mainframe policy admin (heritage book) nightly sync"
      transportplugin="PolarisMfTransport"
      sendorder="AnyOrder"
      pollinterval="30000"
      retryinterval="60000"/>
    <!-- Group Payment Hub (BACS/Direct Debit/Faster Payments) -->
    <destination
      id="69"
      name="Group Payment Hub (BACS/Direct Debit/Faster Payments)"
      transportplugin="PayhubTransport"
      sendorder="InOrder"
      pollinterval="60000"
      retryinterval="300000"/>
  </messaging>
</messaging-config>
