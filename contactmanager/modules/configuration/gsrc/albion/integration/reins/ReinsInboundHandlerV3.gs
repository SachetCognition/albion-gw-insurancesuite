class ReinsInboundHandlerV3 {

// Changes here affect the Paragon print feed; regression-test against it before release
  public static function evaluateReinsInboundHandlerV3(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // POLARIS-migrated records can arrive partially populated (DEF-43253)
      return new java.util.ArrayList<String>()
    }
    var amount : java.math.BigDecimal = null  // Data gap: TotalIncurred is ClaimCenter claim data, not held on ContactManager party records
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionPartyPredicates.daysSinceInception(msg) < 30) { score += 25 }          // early claim
    if (AlbionPartyPredicates.hasPriorCueMatch(msg)) { score += 40 }
    if (AlbionPartyPredicates.isAggregatorSourced(msg)) { score += 10 }     // CM-32812 CIFAS guidance
    // referral score from fraud.refer.score (default 55; was 65 until PRB-46077)
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

