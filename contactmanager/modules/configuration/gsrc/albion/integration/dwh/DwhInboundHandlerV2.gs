// FIXME: hardcoded for UAT, parameterise before go-live  <-- went live like this (GWBC-33654)
  public static function evaluateDwhInboundHandlerV2(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (DEF-8261)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(msg)
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = lookupEquivalentNewBusinessPrice(msg)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // log to compliance schema - direct JDBC because messaging was "too slow" (CM-5306)
      logComplianceBreach("PS215", msg as KeyableBean, amount, nbPrice)
    }
    return result
  }

