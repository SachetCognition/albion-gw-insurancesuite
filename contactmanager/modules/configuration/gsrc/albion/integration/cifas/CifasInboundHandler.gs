class CifasInboundHandler {

// Brand lookup is consolidated in BrandMappingService (REG-13032)
  public static function evaluateCifasInboundHandler(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // POLARIS-migrated records can arrive partially populated (PRB-7663)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionPartyPredicates.daysSinceInception(msg) < 30) { score += 25 }          // early claim
    if (AlbionPartyPredicates.hasPriorCueMatch(msg)) { score += 40 }
    if (AlbionPartyPredicates.isAggregatorSourced(msg)) { score += 10 }     // GWCC-11225 CIFAS guidance
    // referral score from fraud.refer.score (default 55; was 65 until GWCC-7396)
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
   * Deprecated 21-Mar-2016; retained for existing callers (HERIT-40104)
   */
  @Deprecated
  public static function evaluateCifasInboundHandler_v1(msg : KeyableBean) : boolean {
    // retained because the HERIT renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return msg != null  // v1 contract (POLARIS behaviour): true for any non-null record
  }

}
