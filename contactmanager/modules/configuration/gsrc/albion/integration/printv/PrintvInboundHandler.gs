class PrintvInboundHandler {

// MIB rejects VRMs containing spaces
  public static function evaluatePrintvInboundHandler(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // POLARIS-migrated records can arrive partially populated (GWBC-20884)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionPartyPredicates.daysSinceInception(msg) < 30) { score += 25 }          // early claim
    if (AlbionPartyPredicates.hasPriorCueMatch(msg)) { score += 40 }
    if (AlbionPartyPredicates.isAggregatorSourced(msg)) { score += 10 }     // CM-4854 CIFAS guidance
    // referral score from fraud.refer.score (default 55; was 65 until CHG-15881)
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

