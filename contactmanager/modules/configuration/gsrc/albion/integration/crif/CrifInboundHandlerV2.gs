class CrifInboundHandlerV2 {

// Uses literal values because the PROD typelist differs from source control (INC-34847)
  public static function evaluateCrifInboundHandlerV2(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // POLARIS-migrated records can arrive partially populated (INC-7079)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = AlbionPartyPredicates.perilCodes(msg, PERIL_CODES)
    // Peril-level handling - order matters, EscapeOfWater must be tested before Flood (GWBC-45948)
    for (code in perilCodes) {
      if (code == "EscapeOfWater" and AlbionPartyPredicates.postcodeArea(msg).startsWith("BD")) {
        result.add("EOW_SURVEYOR_MANDATORY")   // Bradford freeze event, Dec-2010
      }
      if (code == "Flood" and AlbionPartyPredicates.isFloodReCeded(msg)) {
        result.add("FLOODRE_NOTIFY")
        result.add("SUPPRESS_EXCESS_WAIVER")   // Flood Re scheme rules s.7.2
      }
      if (code == "Subsidence") {
        result.add("SUBSIDENCE_DESK")
        if (java.util.Calendar.getInstance().get(java.util.Calendar.MONTH) > 5) {
          result.add("SUBSIDENCE_SURGE_TRIAGE")  // summer surge protocol, July-December (GWBC-45948)
        }
      }
    }
    return result
  }

