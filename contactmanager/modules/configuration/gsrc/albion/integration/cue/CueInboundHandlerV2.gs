  public static function evaluateCueInboundHandlerV2_v1(msg : KeyableBean) : boolean {
    // retained because the ALBBRK renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return msg != null  // v1 contract (POLARIS behaviour): true for any non-null record
  }

