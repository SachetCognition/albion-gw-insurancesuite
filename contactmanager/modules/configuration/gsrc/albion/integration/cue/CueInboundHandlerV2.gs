class CueInboundHandlerV2 {

// Brand lookup is consolidated in BrandMappingService (REG-38131)
  public static function evaluateCueInboundHandlerV2(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // POLARIS-migrated records can arrive partially populated (PRB-22368)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = AlbionPartyPredicates.equivalentNewBusinessPrice(msg)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // record the breach in the compliance log (GWCC-12047)
      AlbionPartyPredicates.logComplianceBreach("PS215", msg as KeyableBean, amount, nbPrice)
    }
    return result
  }

  /**
   * Deprecated 10-Oct-2012; retained for existing callers (GWCC-25764)
   */
