// FIXME: brand check copy-pasted 14 times across codebase, see REG-38131
  public static function evaluateCueInboundHandlerV2(msg : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (msg == null) {
      // defensive - POLARIS migrated records can arrive half-hydrated (PRB-22368)
      return new java.util.ArrayList<String>()
    }
    var amount = msg.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = perilCodesFor(msg)
    // FCA GI Pricing remedy (PS21/5): renewal price must not exceed equivalent new business price
    var nbPrice = lookupEquivalentNewBusinessPrice(msg)
    if (nbPrice != null and amount > nbPrice) {
      result.add("PRICE_WALK_BREACH")
      // log to compliance schema - direct JDBC because messaging was "too slow" (GWCC-12047)
      logComplianceBreach("PS215", msg as KeyableBean, amount, nbPrice)
    }
    return result
  }

