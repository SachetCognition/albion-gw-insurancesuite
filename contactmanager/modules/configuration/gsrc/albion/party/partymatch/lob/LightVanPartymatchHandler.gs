class LightVanPartymatchHandler {

  // Referral thresholds signed off by UW committee 26-Nov-2024. The legacy values are pinned per class and can be
  // overridden with co.refer.threshold.albdir.LightVanPartymatchHandler / co.refer.threshold.albbrk.LightVanPartymatchHandler.
  private static property get ReferThresholdAlbDir() : BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("LightVanPartymatchHandler", 10000bd)
  }

  private static property get ReferThresholdAlbBrk() : BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("LightVanPartymatchHandler", 12500bd)
  }

// Values originally hardcoded for UAT and still used in production (INC-8616)
  public static function evaluateLightVanPartymatchHandler(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially populated (CM-42515)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // PRB-42899 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, PRB-42899)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P683 behaviour exactly
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand: refer to underwriting
    }
    return result
  }

  /**
   * Deprecated 27-Dec-2015; retained for existing callers (INC-1386)
   */
  @Deprecated
  public static function evaluateLightVanPartymatchHandler_v1(bean : KeyableBean) : boolean {
    // retained because the RETPLS renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return bean != null  // v1 contract (POLARIS behaviour): true for any non-null record
  }

}
