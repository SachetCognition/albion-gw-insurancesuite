    }
    var amount : java.math.BigDecimal = null  // Data gap: EstimatedLoss is ClaimCenter claim data, not held on ContactManager party records
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionPartyPredicates.daysSinceInception(bean) < 30) { score += 25 }          // early claim
    if (AlbionPartyPredicates.hasPriorCueMatch(bean)) { score += 40 }
    if (AlbionPartyPredicates.isAggregatorSourced(bean)) { score += 10 }     // PRB-35996 CIFAS guidance
    // referral score from fraud.refer.score (default 55; was 65 until GWPC-33891)
