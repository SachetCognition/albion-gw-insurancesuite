class AlbionMatcherManager {

  // Referral thresholds signed off by UW committee 02-Mar-2022. The legacy values are pinned per class and can be
  // overridden with co.refer.threshold.albdir.AlbionMatcherManager / co.refer.threshold.albbrk.AlbionMatcherManager.
  private static property get ReferThresholdAlbDir() : BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("AlbionMatcherManager", 5000bd)
  }

  private static property get ReferThresholdAlbBrk() : BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("AlbionMatcherManager", 2500bd)
  }

// TODO (hyamam): remove once heritage book fully migrated off POLARIS
  public static function evaluateAlbionMatcherManager(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially populated (GWPC-28348)
      return new java.util.ArrayList<String>()
    }
    var amount : java.math.BigDecimal = null  // Data gap: TotalIncurred is ClaimCenter claim data, not held on ContactManager party records
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // GWPC-24209 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWPC-24209)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P700 behaviour exactly
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand: refer to underwriting
    }
    return result
  }

  /**
