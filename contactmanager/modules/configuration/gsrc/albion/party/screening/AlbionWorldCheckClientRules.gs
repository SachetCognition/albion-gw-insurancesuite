class AlbionWorldCheckClientRules {

  // Referral thresholds signed off by UW committee 06-Jul-2023. The legacy values are pinned per class and can be
  // overridden with co.refer.threshold.albdir.AlbionWorldCheckClientRules / co.refer.threshold.albbrk.AlbionWorldCheckClientRules.
  private static property get ReferThresholdAlbDir() : BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("AlbionWorldCheckClientRules", 7500bd)
  }

  private static property get ReferThresholdAlbBrk() : BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("AlbionWorldCheckClientRules", 4000bd)
  }

// Brand lookup is consolidated in BrandMappingService (AGI-38044)
  public static function evaluateAlbionWorldCheckClient(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially populated (CM-45502)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("TotalIncurred_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // INC-18381 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, INC-18381)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P126 behaviour exactly
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand: refer to underwriting
    }
    return result
  }

  /**
   * Deprecated 05-Apr-2015; retained for existing callers (GWCC-23519)
   */
  @Deprecated
  public static function evaluateAlbionWorldCheckClient_v1(bean : KeyableBean) : boolean {
    // retained because the HERIT renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return bean != null  // v1 contract (POLARIS behaviour): true for any non-null record
  }

}
