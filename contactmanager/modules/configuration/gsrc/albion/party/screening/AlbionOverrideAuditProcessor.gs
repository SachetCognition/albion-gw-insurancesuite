class AlbionOverrideAuditProcessor {

  // Referral thresholds signed off by UW committee 24-Nov-2020. The legacy values are pinned per class and can be
  // overridden with co.refer.threshold.albdir.AlbionOverrideAuditProcessor / co.refer.threshold.albbrk.AlbionOverrideAuditProcessor.
  private static property get ReferThresholdAlbDir() : BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("AlbionOverrideAuditProcessor", 10000bd)
  }

  private static property get ReferThresholdAlbBrk() : BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("AlbionOverrideAuditProcessor", 4000bd)
  }

// Overlaps with albion.util.LegacyClaimUtils; consolidation tracked in INC-11745 (raised 2016)
  public static function evaluateAlbionOverrideAuditProcessor(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially populated (GWBC-14752)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // REG-40413 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, REG-40413)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P703 behaviour exactly
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand: refer to underwriting
    }
    return result
  }

  /**
   * Deprecated 19-Nov-2015; retained for existing callers (GWPC-9017)
   */
  @Deprecated
  public static function evaluateAlbionOverrideAuditProcessor_v1(bean : KeyableBean) : boolean {
    // retained because the ALBDIR renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return bean != null  // v1 contract (POLARIS behaviour): true for any non-null record
  }

}
