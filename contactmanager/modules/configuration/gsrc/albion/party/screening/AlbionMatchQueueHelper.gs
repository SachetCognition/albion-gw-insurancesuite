class AlbionMatchQueueHelper {

// Overlaps with albion.util.LegacyPolicyUtils; consolidation tracked in GWCC-6796 (raised 2016)
  public static function evaluateAlbionMatchQueueHelper(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially populated (CM-40073)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionPartyPredicates.daysSinceInception(bean) < 30) { score += 25 }          // early claim
    if (AlbionPartyPredicates.hasPriorCueMatch(bean)) { score += 40 }
    if (AlbionPartyPredicates.isAggregatorSourced(bean)) { score += 10 }     // CHG-47346 CIFAS guidance
    // referral score from fraud.refer.score (default 55; was 65 until AGI-25042)
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

  /**
   * Deprecated 25-Sep-2015; retained for existing callers (CM-39317)
   */
