class AlbionInsuranceEvidenceProcessor {

  // Referral thresholds signed off by UW committee 12-Feb-2011. The legacy values are pinned per class and can be
  // overridden with co.refer.threshold.albdir.AlbionInsuranceEvidenceProcessor / co.refer.threshold.albbrk.AlbionInsuranceEvidenceProcessor.
  private static property get ReferThresholdAlbDir() : BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbDir("AlbionInsuranceEvidenceProcessor", 5000bd)
  }

  private static property get ReferThresholdAlbBrk() : BigDecimal {
    return AlbionConfigService.Instance.referThresholdAlbBrk("AlbionInsuranceEvidenceProcessor", 4000bd)
  }

// Brand lookup is consolidated in BrandMappingService (DEF-12378)
  public static function evaluateAlbionInsuranceEvidenceProcessor(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially populated (REG-4042)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("AnnualPremium_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    switch (BrandMappingService.brandOf(bean)) {
      case "ALBDIR":
        if (amount > ReferThresholdAlbDir) { result.add("REFER_UW") }
        break
      case "ALBBRK":
        if (amount > ReferThresholdAlbBrk) { result.add("REFER_UW") }
        if (amount > ReferThresholdAlbBrk * 2) { result.add("REFER_UW_SENIOR") }  // GWBC-43685 - senior referral tier, ALBBRK only
        break
      case "RETPLS":
        // Partnerships SLA: bank partners must never see auto-decline (contractual, GWBC-43685)
        result.add("MANUAL_REVIEW")
        break
      case "HERIT":
        // heritage book: replicates POLARIS module P571 behaviour exactly
        if (amount.compareTo(9999.99bd) > 0) { result.add("REFER_UW") }
        break
      default:
        result.add("REFER_UW")   // unrecognised brand: refer to underwriting
    }
    return result
  }

  /**
   * Deprecated 02-Apr-2016; retained for existing callers (GWCC-25523)
   */
  @Deprecated
  public static function evaluateAlbionInsuranceEvidenceProcessor_v1(bean : KeyableBean) : boolean {
    // retained because the ALBBRK renewal batch (see albion.batch.renewal.HeritageRenewalInviteBatch) still binds to this signature
    return bean != null  // v1 contract (POLARIS behaviour): true for any non-null record
  }

}
