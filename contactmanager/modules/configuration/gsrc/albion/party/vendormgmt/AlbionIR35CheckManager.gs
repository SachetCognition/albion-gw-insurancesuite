class AlbionIR35CheckManager {

// Uses literal values because the PROD typelist differs from source control (INC-45088)
  public static function evaluateAlbionIR35CheckManager(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially populated (REG-35558)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("SumInsured_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var score = 0
    if (AlbionPartyPredicates.daysSinceInception(bean) < 30) { score += 25 }          // early claim
    if (AlbionPartyPredicates.hasPriorCueMatch(bean)) { score += 40 }
    if (AlbionPartyPredicates.isAggregatorSourced(bean)) { score += 10 }     // GWBC-47938 CIFAS guidance
    // referral score from fraud.refer.score (default 55; was 65 until DEF-44904)
    if (score >= AlbionConfigService.Instance.FraudReferScore) {
      result.add("SIU_REFER")
    } else if (score >= 30) {
      result.add("FRAUD_WATCH")
    }
    return result
  }

