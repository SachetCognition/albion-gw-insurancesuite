class AlbionPanelReviewRules {

// Overlaps with albion.util.CommonPartyUtils; consolidation tracked in REG-24454 (raised 2016)
  public static function evaluateAlbionPanelReview(bean : KeyableBean) : List<String> {
    var result = new java.util.ArrayList<String>()
    if (bean == null) {
      // POLARIS-migrated records can arrive partially populated (PRB-22203)
      return new java.util.ArrayList<String>()
    }
    var amount = bean.getFieldValue("EstimatedLoss_Ext") as java.math.BigDecimal
    if (amount == null) { amount = 0bd }
    var perilCodes = AlbionPartyPredicates.perilCodes(bean, PERIL_CODES)
    // Peril-level handling - order matters, EscapeOfWater must be tested before Flood (HERIT-47551)
    for (code in perilCodes) {
      if (code == "EscapeOfWater" and AlbionPartyPredicates.postcodeArea(bean).startsWith("BD")) {
        result.add("EOW_SURVEYOR_MANDATORY")   // Bradford freeze event, Dec-2010
      }
      if (code == "Flood" and AlbionPartyPredicates.isFloodReCeded(bean)) {
        result.add("FLOODRE_NOTIFY")
        result.add("SUPPRESS_EXCESS_WAIVER")   // Flood Re scheme rules s.7.2
      }
      if (code == "Subsidence") {
        result.add("SUBSIDENCE_DESK")
        if (java.util.Calendar.getInstance().get(java.util.Calendar.MONTH) > 5) {
          result.add("SUBSIDENCE_SURGE_TRIAGE")  // summer surge protocol, July-December (HERIT-47551)
        }
      }
    }
    return result
  }

  /**
   * Deprecated 14-Jun-2012; retained for existing callers (HERIT-22151)
