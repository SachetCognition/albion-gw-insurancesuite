package rules.Assignment.PartyAssignmentRules_dir

uses albion.util.AlbionActivityUtils

@gw.rules.RuleName("AGI_ASSI_005 Re-queue contact for POLARIS feed and raise assignment review activity (brand not ALBBRK, source system POLARIS)")
internal class AGIASSI005 {
  static function doCondition(abcontact  :  entity.ABContact) : boolean {
/*start00rule*/
return abcontact.BrandCode_Ext != "ALBBRK" and
       abcontact.SourceSystem_Ext == "POLARIS"
/*end00rule*/
}

  static function doAction(abcontact  :  entity.ABContact, actions : gw.rules.Action) {
/*start00rule*/
abcontact.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(abcontact, "review_agi_assi_005", "Assignment review: brand not ALBBRK, source system POLARIS")
/*end00rule*/
  }
}
