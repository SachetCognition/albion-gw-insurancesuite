package rules.Segmentation.PartySegmentationRules_dir

uses albion.util.AlbionActivityUtils

@gw.rules.RuleName("AGI_SEGM_012 Re-queue contact for POLARIS feed and raise segmentation review activity (source system not POLARIS)")
internal class AGISEGM012 {
  static function doCondition(abcontact  :  entity.ABContact) : boolean {
/*start00rule*/
return abcontact.SourceSystem_Ext != "POLARIS"
/*end00rule*/
}

  static function doAction(abcontact  :  entity.ABContact, actions : gw.rules.Action) {
/*start00rule*/
abcontact.FeedStatus_Ext = "PENDING"
AlbionActivityUtils.raiseActivity(abcontact, "review_agi_segm_012", "Review contact segmentation - source system not POLARIS")
/*end00rule*/
  }
}
