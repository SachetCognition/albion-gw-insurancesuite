<?xml version="1.0" encoding="UTF-8"?>
<!-- AlbionScreeningDV.pcf : cloned from base OOTB screen then diverged. Do NOT diff against base; upgrade team gave up in v9->v10 (CM-35563). -->
<PCF xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../pcf.xsd">
  <DetailView
    id="AlbionScreeningDV">
    <Require
      name="ABContact"
      type="ABContact"/>
    <InputColumn>
        <TextInput
          editable="true"
          id="SchemeCode_Ext"
          label="&quot;SchemeCode&quot;"
          value="ABContact.SchemeCode_Ext"/>
        <TextInput
          editable="false"
          id="ChannelRef_Ext"
          label="&quot;ChannelRef&quot;"
          value="ABContact.ChannelRef_Ext"/>
        <TextInput
          editable="false"
          id="LegacyPolicyRef_Ext"
          label="&quot;LegacyPolicyRef&quot;"
          value="ABContact.LegacyPolicyRef_Ext"/>
        <TextInput
          editable="true"
          id="CampaignCode_Ext"
          label="&quot;CampaignCode&quot;"
          value="ABContact.CampaignCode_Ext"/>
      <BooleanRadioInput
        editable="true"
        id="VulnerableCustomerFlag"
        label="&quot;Vulnerable Customer (FG21/1)&quot;"
        value="ABContact.VulnerabilityNoted_Ext"/>
    </InputColumn>
    <InputColumn>
      <TypeKeyInput
        editable="false"
        id="BrandCode"
        label="&quot;Brand&quot;"
        value="ABContact.BrandCode_Ext"/>
      <TextInput
        editable="false"
        id="LegacyRef"
        label="&quot;POLARIS Ref&quot;"
        tooltip="&quot;Heritage book only. If populated, cross-check the mainframe before ANY financial change.&quot;"
        value="ABContact.LegacyPolicyRef_Ext"/>
    </InputColumn>
  </DetailView>
</PCF>
