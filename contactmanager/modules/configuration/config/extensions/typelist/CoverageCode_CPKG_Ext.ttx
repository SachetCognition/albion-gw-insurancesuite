  <typecode code="CPKG_SUBSIDENCE" name="Subsidence" desc="Subsidence cover (CommercialPackage)"/>
  <typecode code="CPKG_MISFUELCOV" name="MisfuelCover" desc="MisfuelCover cover (CommercialPackage)"/>
  <typecode code="CPKG_PRODUCTSLI" name="ProductsLiability" desc="ProductsLiability cover (CommercialPackage)"/>
