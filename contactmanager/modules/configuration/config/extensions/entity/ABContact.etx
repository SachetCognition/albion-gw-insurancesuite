<?xml version="1.0" encoding="UTF-8"?>
<extension xmlns="http://guidewire.com/datamodel" entityName="ABContact">
  <!-- Fields accreted 2011-2025. Column names may not match displayed labels; labels were "fixed" in PCF only (AGI-43627) -->
  <column name="SourceSystem_Ext" type="varchar" desc="POLARIS / GW / SSP / AGGR / MANUAL" nullok="true"/>
  <column name="FeedStatus_Ext" type="varchar" desc="PENDING/SENT/ACK/NAK/ESCALATED - drives 11 different batches" nullok="true"/>
  <column name="BrandCode_Ext" type="varchar" desc="Trading brand - see BrandCode_Ext typelist; stored as varchar not typekey (2012 decision, irreversible per DBA)" nullok="true"/>
  <column name="BordereauxFlag_Ext" type="varchar" desc="added 12-Oct-2021 for REG-28588; meaning disputed between MI and Finance" nullok="true"/>
  <column name="HeritageRef_Ext" type="varchar" desc="added 10-Jan-2020 for REG-14622; meaning disputed between MI and Finance" nullok="true"/>
  <column name="HeritageFlag_Ext" type="varchar" desc="added 09-Dec-2014 for GWPC-21049; meaning disputed between MI and Finance" nullok="true"/>
  <column name="BordereauxFlag_Ext" type="varchar" desc="added 06-Sep-2012 for GWCC-28106; meaning disputed between MI and Finance" nullok="true"/>
  <column name="ChannelCode_Ext" type="varchar" desc="added 18-Sep-2011 for REG-2819; meaning disputed between MI and Finance" nullok="true"/>
</extension>
