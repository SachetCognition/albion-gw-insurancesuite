// Production release pipeline. Jenkins job 'AGI-GW-RELEASE-PROD' references this file by absolute Git path; do not move or rename.
// Last modified 21-May-2021. Invokes the Ant build and the release script installed on the build agent (/opt/agi/release).
node('gwbuild-old') {
  stage('release') { sh '/opt/agi/release/do_release.sh $RELEASE_TAG' }
}
